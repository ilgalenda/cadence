# ============================================================
# SECRETS & CREDENTIALS — never commit these
# ============================================================
backend/.env
backend/agents/lead/data/google_tokens.json
# Per-environment bcrypt password hashes. Written by `python backend/seed_users.py`
# into ${DATA_ROOT}/agents/users_credentials.json. Never committed.
backend/agents/users_credentials.json
agents/users_credentials.json
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*_secret*
*_credentials*
*apikey*
*api_key*

