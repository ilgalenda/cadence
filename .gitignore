# ============================================================
# VAULT & AGENT DATA — operational CONTENT, never in this public mirror
# (the architecture/structure travels; the content does not).
# Directory skeletons and generic docs are kept via the negations below.
# ============================================================
# Knowledge vault — entities, glossary, research, calls, personas, etc.
backend/vault/company/
backend/vault/dynamic/
backend/vault/added/
backend/vault/*.md
backend/vault/.obsidian/
# Per-agent runtime state and per-user learnings
backend/agents/*/data/*.json
backend/agents/*/data/learnings/
backend/agents/*/data/transcripts/
backend/agents/*/data/_sandbox/
backend/agents/*/knowledge/_user/
backend/agents/*/knowledge/company-*.md
# User profiles (real roster) — regenerate locally via seed_users.py --rewrite-profiles
backend/agents/users.json
agents/users.json
# Keep directory skeletons and generic docs so the structure is reproducible
!**/.gitkeep
!**/README.md
# Stray backups inside data dirs only — main *.bak rule below covers most
backend/agents/*/data/*.bak
# SQLite write-ahead-log sidecars are transient
*.db-wal
*.db-shm

# ============================================================
# MEDIA & UPLOADS (large/generated files)
# ============================================================
backend/data/uploads/
*.mp4
*.mov
*.avi
*.mkv

# ============================================================
# macOS
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================================
# EDITORS
# ============================================================
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath

# ============================================================
# LOGS & TEMP
# ============================================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig

# The genericisation map names the employer in order to remove it, so it is the
# one file in tools/ that cannot be published.
tools/genericise.map.json
