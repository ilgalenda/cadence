# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# -----------------------------------------------------------------------------

# DATA_ROOT — where Cadence stores all mutable state (vault, sessions, leads,
# users.json, users_credentials.json, etc.).
#
# Two real modes:
#
#   1. Local dev (laptop) — point DATA_ROOT at a path OUTSIDE the repo so
#      test writes never appear in `git status`. Example:
#          DATA_ROOT=/Users/you/cadence-data
#      Refresh the data with `bin/sync-from-repo.sh` after `git pull`.
#
#   2. Production (server) — point DATA_ROOT at the repo's backend/ (or
#      a wrapper dir the data-sync cron pushes from). Example:
#          DATA_ROOT=/srv/cadence/backend
#
# If unset, defaults to ~/cadence-data.
DATA_ROOT=

# Anthropic — get from https://console.anthropic.com/ → Settings → API Keys
ANTHROPIC_API_KEY=

# Google OAuth — one grant for Gmail drafting and Calendar, not two
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials
# → Create OAuth client → Web application.
# Add the GOOGLE_REDIRECT_URI below to "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NOTE: this path moved in Stage 3.3, from /api/lead/google/callback, when
# `agents/lead` was retired. An existing deployment must update BOTH this value
# and the authorised redirect URI in the Google Console, or the flow fails with
# redirect_uri_mismatch.
#
# SCOPES (Phase 4a): the client must be allowed calendar.events, userinfo.email and
# gmail.compose. `gmail.compose` creates drafts and can neither read the mailbox nor
# send. Adding it means every already-connected user must reconnect once — the
# Integrations page detects this and says so rather than failing silently.
# Local dev default below. For production, set to e.g.
# https://cadence.acme.example/api/integrations/google/callback
# and register the same value in Google Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Session — required. Must be a long random string.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Set to true for local development (enables hot-reload, disables https-only cookies).
# MUST be false in production.
DEBUG=true

# Lusha — REQUIRED for X-Ray to reveal any contact details.
# Get from https://dashboard.lusha.com/ → API. Auth is the `api_key` request
# header; `LushaClient` reads this variable and raises immediately if it is
# missing, so a blank value is not a degraded mode — every reveal returns 502.
#
# It spends money. One credit per person revealed, charged per person and not
# per call: email via /enrich (one bulk request, up to 15 people — X-Ray's
# result cap), phone via /reveal-phone, one person at a time. There is no
# balance endpoint, so nothing in Cadence can tell you how many credits remain.
LUSHA_API_KEY=

# Opt-in for the one test that hits the real Lusha API (`test_enrichment.py`).
# Unset by default because running it charges real credits. LUSHA_LIVE=1 to run.
# LUSHA_LIVE=

# X-Ray second name source — gtm.ai / ZoomInfo MCP (OFF by default).
# gtm.ai is ZoomInfo's GTM AI MCP (https://mcp.zoominfo.com/mcp). The search
# tools don't burn credits, but a paid ZoomInfo seat is required to authenticate
# at all, so this stays disabled until a seat is evaluated. When enabled, X-Ray
# runs it as an INDEPENDENT second source alongside web_search and merges names.
GTMAI_ENABLED=false
# ZOOMINFO_MCP_URL=https://mcp.zoominfo.com/mcp
# ZOOMINFO_USERNAME=
# ZOOMINFO_CLIENT_ID=
# ZOOMINFO_PRIVATE_KEY=

# Admin notifications (Added Knowledge approval flow)
# All five SMTP_* + ADMIN_NOTIFY_EMAIL must be set for email to actually send.
# When unset, the system logs and skips silently — the in-app badge still works.
# For Gmail SMTP_PASSWORD, generate an App Password:
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=admin@acme.example

# Where this Cadence answers, used for the link in notification emails. Falls
# back to the origin of GOOGLE_REDIRECT_URI, which must already match the
# deployment's public origin — set this explicitly on the server, where that
# fallback is right but easy to get wrong. No link is sent rather than a broken
# one when neither resolves.
PUBLIC_BASE_URL=

# The shared events spreadsheet — the working document Alex, Nils, Jo and
# operations read, none of whom have a Cadence account. Cadence writes it and
# never reads it back.
#
# Create it once with `python3 backend/check_sheet.py`, put the id it prints
# here, then share the file from Drive. Cadence asks for no Drive scope, so who
# can open it stays a person's decision.
EVENTS_SHEET_ID=
# Whose Google connection writes it. The file lives in one person's Drive, and a
# registration filed by somebody with no Google grant must still reach it.
# Defaults to the first admin who has connected.
SHEET_SYNC_USER=

# User passwords — used by `python backend/seed_users.py` to write the
# gitignored ${DATA_ROOT}/agents/users_credentials.json. Each environment
# (your laptop, the live server) has its own credentials file; passwords
# never enter git. Re-run seed_users.py after changing any of these.
# One per user in your roster, named <USER>_PASSWORD.
ADMIN_PASSWORD=
SALES_ONE_PASSWORD=
SALES_TWO_PASSWORD=
