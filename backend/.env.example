# Copy this file to .env and fill in your values
# Never commit .env to version control

# Anthropic
ANTHROPIC_API_KEY=

# Google OAuth (for Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/lead/google/callback

# Session — required, must be a long random string
SESSION_SECRET=

# Set to true for local development (enables hot-reload, disables https-only cookies)
DEBUG=true

# User passwords (used by seed_users.py)
ADMIN_PASSWORD=
TEST_PASSWORD=
