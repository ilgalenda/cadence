---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { @@CONST@@_AGENT_NAME, @@CONST@@_AGENT_TAGLINE, @@CONST@@_NAV } from '../../../agents/@@SLUG@@/config';
---
<AgentLayout title="Overview" agentName={@@CONST@@_AGENT_NAME} agentTagline={@@CONST@@_AGENT_TAGLINE} navItems={@@CONST@@_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader label="Workspace · @@NAME@@" heading="@@NAME@@." lead="@@TAGLINE@@.">
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <div class="grid grid-cols-4 border-y border-rule-strong mb-14">
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">@@ENTITY_TITLE@@s</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-total">—</p>
      </div>
    </div>

    <p class="font-mono text-[11px] text-ink-muted">// @@NAME@@ — scaffolded by create_agent.py. Build out this surface.</p>
  </div>

  <script>
    async function loadStats() {
      try {
        const res = await fetch('/api/@@SLUG@@/stats');
        const d = await res.json();
        document.getElementById('stat-total')!.textContent = String(d.@@ENTITY_PLURAL@@_total ?? 0).padStart(2, '0');
      } catch {}
    }
    loadStats();
  </script>
</AgentLayout>
