---
interface Props {
  topic?: string;
  source?: string;
  label?: string;
  variant?: 'primary' | 'subtle';
}
const { topic = '', source = '', label = 'Launch campaign in Lead Agent', variant = 'subtle' } = Astro.props;
const classes = variant === 'primary'
  ? 'inline-flex items-center gap-2 bg-surface-ink hover:bg-accent text-ink-inverse px-4 py-2 rounded-sm text-sm font-medium transition-colors duration-150 ease-decelerate'
  : 'inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-accent transition-colors duration-150';
---
<button
  type="button"
  class={`lead-handoff-btn ${classes}`}
  data-topic={topic}
  data-source={source}
>
  <span>{label}</span>
  <span class="font-mono">→</span>
</button>

<script is:inline>
  if (!window.__leadHandoffWired) {
    window.__leadHandoffWired = true;

    function ensureToastRoot() {
      let root = document.getElementById('lead-toast-root');
      if (!root) {
        root = document.createElement('div');
        root.id = 'lead-toast-root';
        root.className = 'fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none';
        document.body.appendChild(root);
      }
      return root;
    }

    window.showLeadToast = function (topic) {
      const root = ensureToastRoot();
      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-surface-ink text-ink-inverse px-4 py-3 rounded-sm shadow-lg max-w-sm text-sm leading-snug transition-opacity duration-300 opacity-0';
      const pretty = topic ? `"${topic}"` : 'this topic';
      toast.innerHTML = `
        <p class="font-mono text-[10px] uppercase tracking-label text-ink-inverse/70 mb-1">Lead agent · coming soon</p>
        <p>This will launch an outreach campaign for ${pretty.replace(/</g, '&lt;')}.</p>
      `;
      root.appendChild(toast);
      requestAnimationFrame(() => { toast.classList.remove('opacity-0'); toast.classList.add('opacity-100'); });
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
        setTimeout(() => toast.remove(), 400);
      }, 3400);
    };

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.lead-handoff-btn');
      if (!btn) return;
      e.preventDefault();
      const topic = btn.dataset.topic || '';
      const source = btn.dataset.source || 'calls-handoff';
      btn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/lead/campaigns', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: topic ? topic.slice(0, 80) : 'Outreach from call',
            source,
            current_step: 0,
            lead_input: { text: topic || '' },
          }),
        });
        if (!res.ok) throw new Error((await res.json()).detail || 'Could not start campaign');
        const campaign = await res.json();
        window.location.href = `/agents/lead/new?id=${encodeURIComponent(campaign.id)}`;
      } catch (err) {
        window.showLeadToast(topic);
        btn.removeAttribute('disabled');
      }
    });
  }
</script>
