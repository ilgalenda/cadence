---
// Global Owl floating widget. Included in DashboardLayout and AgentLayout.
// A thin client of the shared chat module (src/lib/owlChat.ts) — same SSE
// stream client, markdown renderer, and conversation API as the full page.
import '../styles/owl.css';
---

<!-- FAB -->
<button
  id="owl-fab"
  type="button"
  aria-label="Ask Owl"
  class="fixed bottom-6 right-6 z-40 w-14 h-14 rounded-full bg-accent shadow-lg flex items-center justify-center hover:scale-105 transition-transform duration-150 ease-decelerate"
>
  <span id="owl-fab-inner" class="flex items-center justify-center w-full h-full">
    <img src="/images/owl.png" alt="Owl" class="w-8 h-8 object-contain" />
  </span>
</button>

<!-- Drawer -->
<aside
  id="owl-drawer"
  class="fixed top-0 right-0 h-full w-[440px] max-w-[100vw] bg-surface-0 border-l border-rule-subtle shadow-2xl z-50 flex flex-col transform translate-x-full transition-transform duration-200 ease-decelerate"
  aria-hidden="true"
>
  <!-- Header -->
  <header class="flex items-center justify-between px-5 py-3.5 border-b border-rule-subtle shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-surface-2 border border-rule-subtle flex items-center justify-center overflow-hidden shrink-0">
        <img src="/images/owl.png" alt="" class="w-5 h-5 object-contain" onerror="this.parentElement.innerHTML='🦉'" />
      </div>
      <div>
        <p class="text-sm font-semibold tracking-tightest leading-none">Owl</p>
        <p class="font-mono text-[10px] uppercase tracking-label text-ink-muted mt-0.5" id="owl-model-badge">Timebeat AI</p>
      </div>
    </div>
    <div class="flex items-center gap-1">
      <button id="owl-new-btn" type="button" aria-label="New chat" title="New chat" class="w-7 h-7 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-2 transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <button id="owl-history-btn" type="button" aria-label="Conversation history" title="Past conversations" class="w-7 h-7 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-2 transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="2" width="12" height="1.5" rx="0.75" fill="currentColor"/><rect x="1" y="6.25" width="8" height="1.5" rx="0.75" fill="currentColor"/><rect x="1" y="10.5" width="10" height="1.5" rx="0.75" fill="currentColor"/></svg>
      </button>
      <a id="owl-fullpage" href="/agents/owl" aria-label="Open full page" title="Open full page" class="w-7 h-7 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-2 transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2H2v10h10V9M8.5 1.5H12.5M12.5 1.5V5.5M12.5 1.5L6.5 7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button id="owl-close" type="button" aria-label="Close Owl" class="w-7 h-7 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-2 transition-colors duration-150">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

  <!-- History panel (hidden by default) -->
  <div id="owl-history-panel" class="hidden flex-col flex-1 overflow-hidden">
    <div class="px-5 py-3 border-b border-rule-subtle shrink-0 flex items-center justify-between">
      <p class="font-mono text-[10px] uppercase tracking-label text-ink-muted">Past conversations</p>
      <button id="owl-history-back" type="button" class="font-mono text-[10px] text-ink-muted hover:text-accent transition-colors duration-150">← back</button>
    </div>
    <div id="owl-history-list" class="flex-1 overflow-y-auto px-5 py-3 space-y-px">
      <p class="font-mono text-[11px] text-ink-muted py-4">// loading…</p>
    </div>
  </div>

  <!-- Messages -->
  <div id="owl-messages" class="owl-thread owl-drawer-scale flex-1 overflow-y-auto px-5 py-5 space-y-6">
    <div id="owl-empty" class="flex flex-col gap-6 pt-2">
      <div>
        <p class="label text-ink-muted mb-2">Owl</p>
        <p class="text-sm text-ink-secondary leading-relaxed max-w-xs">
          Your Timebeat knowledge partner. Ask me anything about products, protocols, or your next sales conversation.
        </p>
      </div>
      <div id="owl-suggestions">
        <p class="label text-ink-muted mb-1">Try asking</p>
        <div class="flex flex-col">
          <button data-suggestion="What is PTP and why does it matter?" class="owl-chip group flex items-center gap-2.5 w-full text-left py-2.5 border-b border-rule-subtle/60 text-sm text-ink-secondary hover:text-ink-primary transition-colors duration-150"><span class="font-mono text-accent/40 group-hover:text-accent transition-colors duration-150">→</span><span>What is PTP and why does it matter?</span></button>
          <button data-suggestion="Explain Clock Quorum in simple terms" class="owl-chip group flex items-center gap-2.5 w-full text-left py-2.5 border-b border-rule-subtle/60 text-sm text-ink-secondary hover:text-ink-primary transition-colors duration-150"><span class="font-mono text-accent/40 group-hover:text-accent transition-colors duration-150">→</span><span>Explain Clock Quorum in simple terms</span></button>
          <button data-suggestion="Help me handle a pricing objection" class="owl-chip group flex items-center gap-2.5 w-full text-left py-2.5 border-b border-rule-subtle/60 text-sm text-ink-secondary hover:text-ink-primary transition-colors duration-150"><span class="font-mono text-accent/40 group-hover:text-accent transition-colors duration-150">→</span><span>Help me handle a pricing objection</span></button>
        </div>
      </div>
    </div>
  </div>

  <!-- Input -->
  <form id="owl-form" class="border-t border-rule-subtle p-4 shrink-0">
    <div class="flex items-center gap-2 bg-surface-1 border border-rule-subtle rounded-xl pl-4 pr-2 py-1.5 shadow-lift focus-within:border-accent transition-colors duration-150">
      <input
        id="owl-input"
        type="text"
        placeholder="Ask Owl anything…"
        autocomplete="off"
        class="flex-1 bg-transparent text-sm focus:outline-none placeholder:text-ink-muted"
      />
      <button id="owl-send" type="submit" aria-label="Send" class="w-7 h-7 rounded-lg bg-accent flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity duration-150">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6h10M6 1l5 5-5 5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button id="owl-stop" type="button" aria-label="Stop" class="hidden w-7 h-7 rounded-lg bg-surface-ink flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity duration-150">
        <span class="w-2.5 h-2.5 rounded-[2px] bg-ink-inverse"></span>
      </button>
    </div>
  </form>
</aside>

<script>
  import {
    renderMarkdown, streamChat, listConversations, getConversation,
    getActiveConversationId, setActiveConversationId, relativeTime,
    buildCorrectionCard, type ChatMessage,
  } from '../lib/owlChat';

  // Astro hoists this component's script onto every page that imports it —
  // including pages that conditionally skip rendering the drawer (e.g. the
  // full-page chat sets hideOwlDrawer). Bail out when the drawer DOM is absent
  // so we don't throw on null element lookups.
  if (document.getElementById('owl-drawer')) initOwlDrawer();

  function initOwlDrawer() {
  const fab        = document.getElementById('owl-fab')!;
  const fabInner   = document.getElementById('owl-fab-inner')!;
  const drawer     = document.getElementById('owl-drawer')!;
  const closeBtn   = document.getElementById('owl-close')!;
  const newBtn     = document.getElementById('owl-new-btn')!;
  const messages   = document.getElementById('owl-messages')!;
  const form       = document.getElementById('owl-form') as HTMLFormElement;
  const input      = document.getElementById('owl-input') as HTMLInputElement;
  const sendBtn    = document.getElementById('owl-send')!;
  const stopBtn    = document.getElementById('owl-stop')!;
  const fullpageLink = document.getElementById('owl-fullpage') as HTMLAnchorElement;
  const modelBadge = document.getElementById('owl-model-badge')!;

  const history: ChatMessage[] = [];
  let conversationId: string | null = null;
  let conversationStarted = false;
  let isStreaming = false;
  let abortController: AbortController | null = null;

  const fabImg = fabInner.querySelector('img');
  if (fabImg) fabImg.addEventListener('error', () => { fabInner.innerHTML = '<span style="font-size:1.5rem;line-height:1">🦉</span>'; });

  function openDrawer() {
    drawer.classList.remove('translate-x-full');
    drawer.setAttribute('aria-hidden', 'false');
    setTimeout(() => input.focus(), 220);
  }
  function closeDrawer() {
    drawer.classList.add('translate-x-full');
    drawer.setAttribute('aria-hidden', 'true');
  }

  fab.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && document.activeElement !== input) closeDrawer();
  });
  document.addEventListener('owl:open', () => openDrawer());

  // Carry the active conversation through to the full page.
  fullpageLink.addEventListener('click', () => {
    if (conversationId) fullpageLink.href = `/agents/owl?c=${conversationId}`;
  });

  document.querySelectorAll<HTMLButtonElement>('.owl-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const text = chip.dataset.suggestion || '';
      if (text) { input.value = text; form.requestSubmit(); }
    });
  });

  function startConversation() {
    if (!conversationStarted) {
      conversationStarted = true;
      document.getElementById('owl-empty')?.remove();
    }
  }
  function markTurns() {
    messages.classList.toggle('has-turns', messages.querySelector('.owl-turn') !== null);
  }

  function newChat() {
    if (isStreaming) { abortController?.abort(); setStreaming(false); }
    history.length = 0;
    conversationId = null;
    setActiveConversationId(null);
    messages.innerHTML = '';
    messages.classList.remove('has-turns');
    conversationStarted = false;
    modelBadge.textContent = 'Timebeat AI';
    // Rebuild the empty state.
    const empty = document.createElement('div');
    empty.id = 'owl-empty';
    empty.className = 'flex flex-col gap-6 pt-2';
    empty.innerHTML = `
      <div>
        <p class="label text-ink-muted mb-2">Owl</p>
        <p class="text-sm text-ink-secondary leading-relaxed max-w-xs">Your Timebeat knowledge partner. Ask me anything about products, protocols, or your next sales conversation.</p>
      </div>`;
    messages.appendChild(empty);
    showChatPanel();
    input.focus();
  }

  // The user's question — quiet mono lead + the question as a section head.
  function appendUserMessage(text: string) {
    startConversation();
    const turn = document.createElement('div');
    turn.className = 'owl-turn owl-turn--you';
    const label = document.createElement('p');
    label.className = 'owl-lead-label';
    label.textContent = `// you · ${nowLabel()}`;
    const q = document.createElement('p');
    q.className = 'owl-lead';
    q.textContent = text;
    turn.append(label, q);
    messages.appendChild(turn);
    markTurns();
    messages.scrollTop = messages.scrollHeight;
  }

  // One Owl answer: a byline rule, a breathing dot, then streamed text that
  // settles into typeset prose. Mirrors the full-page transcript.
  function createOwlMessage(model: string | null = null) {
    startConversation();
    const turn = document.createElement('div');
    turn.className = 'owl-turn owl-turn--owl';

    const byline = document.createElement('div');
    byline.className = 'owl-byline';
    const dot = document.createElement('span');
    dot.className = 'owl-byline__dot ' + dotClass(model);
    const tag = document.createElement('span');
    tag.className = 'owl-byline__tag';
    tag.textContent = 'Owl';
    const rule = document.createElement('span');
    rule.className = 'owl-byline__rule';
    byline.append(dot, tag, rule);

    const body = document.createElement('div');
    const think = document.createElement('span');
    think.className = 'owl-think animate-signal-pulse inline-block';
    body.appendChild(think);

    turn.append(byline, body);
    messages.appendChild(turn);
    markTurns();
    messages.scrollTop = messages.scrollHeight;

    let streamEl: HTMLElement | null = null;
    function ensureStream() {
      if (!streamEl) { body.innerHTML = ''; streamEl = document.createElement('div'); streamEl.className = 'owl-streaming'; body.appendChild(streamEl); }
    }
    return {
      turn,
      setModel(m: string) { dot.className = 'owl-byline__dot ' + dotClass(m); },
      get text() { return streamEl?.textContent || ''; },
      setText(full: string) { ensureStream(); streamEl!.textContent = full; },
      finalise(full: string) {
        const rendered = renderMarkdown(full);
        if (!rendered.trim()) { turn.remove(); markTurns(); return; }
        const content = document.createElement('div');
        content.className = 'owl-content';
        content.innerHTML = rendered;
        body.innerHTML = '';
        body.appendChild(content);
        messages.scrollTop = messages.scrollHeight;
      },
    };
  }

  function dotClass(model: string | null): string {
    if (!model) return 'owl-byline__dot--haiku';
    return model.includes('haiku') ? 'owl-byline__dot--haiku' : 'owl-byline__dot--sonnet';
  }
  function nowLabel(): string {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }

  function setStreaming(active: boolean) {
    isStreaming = active;
    input.disabled = active;
    sendBtn.classList.toggle('hidden', active);
    stopBtn.classList.toggle('hidden', !active);
  }

  // ─── Submit ─────────────────────────────────────────────────────────────────

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || isStreaming) return;
    input.value = '';

    appendUserMessage(text);
    history.push({ role: 'user', content: text });

    setStreaming(true);
    abortController = new AbortController();
    const owlMsg = createOwlMessage();
    let gotText = false;

    await streamChat({
      messages: history,
      conversationId,
      signal: abortController.signal,
      onConvId: (id) => { conversationId = id; setActiveConversationId(id); },
      onModel: (model) => {
        owlMsg.setModel(model);
        modelBadge.textContent = `Timebeat AI · ${model.includes('haiku') ? 'haiku' : 'sonnet'}`;
      },
      onText: (_delta, full) => {
        gotText = true;
        owlMsg.setText(full);
        messages.scrollTop = messages.scrollHeight;
      },
      onCorrection: (c) => { messages.appendChild(buildCorrectionCard(c)); messages.scrollTop = messages.scrollHeight; },
      onError: (msg) => {
        // Preserve any text already streamed, then show the error on its own
        // line — don't overwrite the partial answer the user was reading.
        if (owlMsg.text) owlMsg.finalise(owlMsg.text); else { owlMsg.turn.remove(); markTurns(); }
        const err = document.createElement('p');
        err.className = 'font-mono text-[11px] text-signal-danger px-1';
        err.textContent = `// ${msg}`;
        messages.appendChild(err);
        messages.scrollTop = messages.scrollHeight;
      },
      onDone: (full) => {
        if (full) { owlMsg.finalise(full); history.push({ role: 'assistant', content: full }); }
        else if (!gotText) { owlMsg.turn.remove(); markTurns(); }
      },
    });

    setStreaming(false);
    abortController = null;
  });

  stopBtn.addEventListener('click', () => { abortController?.abort(); });
  newBtn.addEventListener('click', newChat);

  // ─── History panel ──────────────────────────────────────────────────────────

  const historyPanel = document.getElementById('owl-history-panel')!;
  const historyList  = document.getElementById('owl-history-list')!;
  const historyBtn   = document.getElementById('owl-history-btn')!;
  const historyBack  = document.getElementById('owl-history-back')!;
  let historyMode = false;

  function showHistoryPanel() {
    historyMode = true;
    messages.classList.add('hidden');
    form.classList.add('hidden');
    historyPanel.classList.remove('hidden');
    historyPanel.classList.add('flex');
    historyBtn.classList.add('text-accent');
    loadHistoryList();
  }

  function showChatPanel() {
    historyMode = false;
    historyPanel.classList.add('hidden');
    historyPanel.classList.remove('flex');
    messages.classList.remove('hidden');
    form.classList.remove('hidden');
    historyBtn.classList.remove('text-accent');
  }

  historyBtn.addEventListener('click', () => historyMode ? showChatPanel() : showHistoryPanel());
  historyBack.addEventListener('click', showChatPanel);

  async function loadHistoryList() {
    historyList.innerHTML = '<p class="font-mono text-[11px] text-ink-muted py-4">// loading…</p>';
    try {
      const sessions = await listConversations();
      if (sessions.length === 0) {
        historyList.innerHTML = '<p class="font-mono text-[11px] text-ink-muted py-4">// No past conversations yet.</p>';
        return;
      }
      historyList.innerHTML = '';
      sessions.forEach(s => {
        const row = document.createElement('button');
        row.type = 'button';
        row.className = 'w-full text-left py-3 border-b border-rule-subtle hover:bg-surface-1 transition-colors duration-150 ease-decelerate -mx-5 px-5 flex flex-col gap-1';
        const modelDot = s.model_used === 'sonnet'
          ? '<span class="inline-block w-1.5 h-1.5 rounded-full bg-accent align-middle mr-1"></span>'
          : '<span class="inline-block w-1.5 h-1.5 rounded-full bg-ink-muted/60 align-middle mr-1"></span>';
        const topics = (s.topics || []).slice(0, 3).map((t: string) =>
          `<span class="font-mono text-[9px] uppercase tracking-label text-ink-muted border border-rule-subtle rounded px-1 py-px">${t}</span>`
        ).join('');
        row.innerHTML = `
          <span class="text-sm text-ink-primary truncate leading-snug">${s.title || 'Chat'}</span>
          <span class="flex items-center gap-2 flex-wrap">
            <span class="font-mono text-[10px] text-ink-muted">${modelDot}${s.model_used || 'owl'} · ${relativeTime(s.ts || s.timestamp || '')}</span>
            <span class="flex gap-1">${topics}</span>
          </span>`;
        row.addEventListener('click', () => loadSession(s.id));
        historyList.appendChild(row);
      });
    } catch {
      historyList.innerHTML = '<p class="font-mono text-[11px] text-ink-muted py-4">// Could not load history.</p>';
    }
  }

  async function loadSession(id: string) {
    showChatPanel();
    messages.innerHTML = '';
    history.length = 0;
    conversationStarted = false;

    startConversation();
    const loadingEl = document.createElement('p');
    loadingEl.className = 'font-mono text-[10px] text-ink-muted text-center py-2';
    loadingEl.textContent = '// loading conversation…';
    messages.appendChild(loadingEl);

    try {
      const session = await getConversation(id);
      const msgs: ChatMessage[] = session.messages || [];

      messages.innerHTML = '';
      conversationStarted = false;
      conversationId = id;            // continuing updates THIS conversation
      setActiveConversationId(id);

      startConversation();
      const banner = document.createElement('div');
      banner.className = 'font-mono text-[10px] text-ink-muted text-center py-1 mb-1';
      banner.textContent = `// loaded · ${session.timestamp || ''}`;
      messages.appendChild(banner);

      msgs.forEach(m => {
        if (m.role === 'user') appendUserMessage(m.content);
        else if (m.role === 'assistant') createOwlMessage(session.model_used).finalise(m.content);
        history.push({ role: m.role, content: m.content });
      });
      markTurns();

      const cont = document.createElement('div');
      cont.className = 'font-mono text-[10px] text-ink-muted text-center pt-2 pb-1';
      cont.textContent = '// continue below ↓';
      messages.appendChild(cont);

      messages.scrollTop = messages.scrollHeight;
      setTimeout(() => input.focus(), 100);
    } catch {
      messages.innerHTML = '';
      conversationStarted = false;
      startConversation();
      const errEl = document.createElement('p');
      errEl.className = 'font-mono text-[11px] text-ink-muted py-4 text-center';
      errEl.textContent = '// Could not load this conversation.';
      messages.appendChild(errEl);
    }
  }

  // External events
  document.addEventListener('owl:load', (e: Event) => {
    const id = (e as CustomEvent).detail?.id;
    if (!id) return;
    openDrawer();
    loadSession(id);
  });

  // Restore the conversation the user was last in (shared with the full page),
  // so reopening the drawer continues where they left off instead of blank.
  // Verify it still exists first so a deleted/stale id silently falls back to
  // the empty state rather than flashing an error.
  (async () => {
    const restoreId = getActiveConversationId();
    if (!restoreId) return;
    try {
      await getConversation(restoreId);
      loadSession(restoreId);
    } catch {
      setActiveConversationId(null);
    }
  })();
  }
</script>
