---
interface Props {
  label?: string;
  heading: string;
  lead?: string;
}
const { label, heading, lead } = Astro.props;
---
<header class="mb-10">
  <div class="flex items-baseline justify-between gap-6 mb-3">
    {label && <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted">{label}</p>}
    {Astro.slots.has('meta') && (
      <div class="font-mono text-[11px] tabular text-ink-muted">
        <slot name="meta" />
      </div>
    )}
  </div>
  <h1 class="text-3xl font-semibold tracking-tightest leading-tight">{heading}</h1>
  {lead && <p class="text-base text-ink-secondary mt-3 max-w-2xl leading-relaxed">{lead}</p>}
</header>
