---
type Variant = 'active' | 'muted' | 'success' | 'warning' | 'danger';
interface Props {
  variant?: Variant;
  label: string;
}
const { variant = 'muted', label } = Astro.props;

// Static literal maps — Tailwind JIT keeps all referenced classes.
const dotClass: Record<Variant, string> = {
  active:  'bg-signal-success animate-signal-pulse',
  muted:   'bg-ink-muted/60',
  success: 'bg-signal-success',
  warning: 'bg-signal-warning',
  danger:  'bg-signal-danger',
};

const textClass: Record<Variant, string> = {
  active:  'text-ink-secondary',
  muted:   'text-ink-muted',
  success: 'text-ink-secondary',
  warning: 'text-ink-secondary',
  danger:  'text-signal-danger',
};
---
<span class="inline-flex items-center gap-2">
  <span class={`w-1.5 h-1.5 rounded-full ${dotClass[variant]}`}></span>
  <span class={`font-mono text-[11px] uppercase tracking-label ${textClass[variant]}`}>{label}</span>
</span>
