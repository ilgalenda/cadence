---
/**
 * Transient confirmation, on the design system's `.ds-toast`.
 *
 * Mount once per page; anywhere in a script:
 *   `window.toast('success' | 'danger' | 'warning' | 'info', 'message')`
 *
 * The variant reads as a **mark** rather than a coloured bar, so a toast carries the
 * same status vocabulary as everything else — locked for done, fault for failed,
 * drift for needs-attention. The four caller-facing variant names are kept because
 * pages already pass them; they map onto the system's three states plus live.
 *
 * The message is assigned with `textContent`. It routinely carries a filename or an
 * API `detail`, so it was interpolated into markup before and should not have been.
 */
---
<div id="toast-host" class="toast-host"></div>

<style>
  /* Placement only — the toast itself is a design-system component. */
  .toast-host {
    position: fixed; bottom: var(--space-6); right: var(--space-6);
    z-index: var(--z-toast);
    display: flex; flex-direction: column; gap: var(--space-2);
    pointer-events: none;
  }
  .toast-host :global(.ds-toast) { pointer-events: auto; max-width: 24rem; }
  .toast-host :global(.ds-toast p) { margin: 0; line-height: var(--leading-snug); }
  /* Leaving is the reverse of the component's own entry. */
  .toast-host :global(.is-leaving) {
    opacity: 0;
    transition: opacity var(--dur-tap) var(--ease-depart);
  }
</style>

<script>
  type Variant = 'success' | 'danger' | 'warning' | 'info';

  /** Caller vocabulary → the design system's status marks. */
  const MARK: Record<Variant, string> = {
    success: 'locked',
    danger: 'fault',
    warning: 'drift',
    info: 'live',
  };

  /** Only a settled outcome gets a word; "info" is just the accent dot. */
  const LABEL: Partial<Record<Variant, string>> = {
    success: 'done',
    danger: 'failed',
    warning: 'check',
  };

  (window as any).toast = (variant: Variant, message: string, ms = 3200) => {
    const host = document.getElementById('toast-host');
    if (!host) return;

    const toast = document.createElement('div');
    toast.className = 'ds-toast';

    const mark = document.createElement('span');
    mark.className = `ds-mark ds-mark--${MARK[variant] ?? 'live'}`;
    mark.textContent = LABEL[variant] ?? '';

    const body = document.createElement('p');
    body.className = 'ds-small';
    body.textContent = message;

    toast.append(mark, body);
    host.append(toast);

    window.setTimeout(() => {
      toast.classList.add('is-leaving');
      window.setTimeout(() => toast.remove(), 200);
    }, ms);
  };
</script>
