---
import '../styles/global.css';
import OwlDrawer from '../components/OwlDrawer.astro';

interface Props {
  title?: string;
}
const { title = 'Dashboard' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Cadence</title>
</head>
<body class="h-full bg-surface-0 text-ink-primary flex flex-col overflow-hidden">

  <header class="h-12 shrink-0 border-b border-rule-subtle bg-surface-1 flex items-center justify-between px-6">
    <div class="flex items-center gap-3">
      <img
        src="/images/timebeat-logo.png"
        alt="Timebeat"
        class="h-5 w-auto object-contain"
        onerror="this.style.display='none'"
      />
      <div class="w-px h-4 bg-rule-subtle"></div>
      <span class="text-sm font-semibold tracking-tightest">Cadence</span>
      <span class="text-xs font-mono text-ink-muted">// internal</span>
    </div>
    <div class="flex items-center gap-5">
      <span id="today" class="text-xs font-mono tabular text-ink-muted"></span>
      <div class="flex items-center gap-2.5">
        <div id="user-avatar" class="w-7 h-7 rounded-full bg-surface-ink flex items-center justify-center text-xs font-semibold text-ink-inverse">·</div>
        <div class="hidden sm:block leading-tight">
          <p id="user-name" class="text-xs font-medium text-ink-primary flex items-center gap-2"></p>
          <p id="user-role" class="text-[11px] text-ink-muted"></p>
        </div>
      </div>
      <button id="logout-btn" class="text-xs text-ink-secondary hover:text-accent transition-colors duration-150 ease-decelerate">
        Log out →
      </button>
    </div>
  </header>

  <main class="flex-1 overflow-y-auto">
    <slot />
  </main>

  <OwlDrawer />

  <script>
    (async () => {
      try {
        const res = await fetch('/api/auth/status');
        const data = await res.json();
        if (!data.authed) {
          window.location.href = '/';
          return;
        }
        const name = data.name || data.username || '';
        const role = data.role || '';
        const initial = (name.trim()[0] || '·').toUpperCase();
        const avatarEl = document.getElementById('user-avatar');
        const nameEl = document.getElementById('user-name');
        const roleEl = document.getElementById('user-role');
        if (avatarEl) avatarEl.textContent = initial;
        if (nameEl) {
          nameEl.textContent = name;
          if (data.access === 'admin') {
            const chip = document.createElement('span');
            chip.className = 'font-mono text-[9px] uppercase tracking-label text-accent';
            chip.textContent = '// admin';
            nameEl.appendChild(chip);
          }
        }
        if (roleEl) roleEl.textContent = role;
        (window as any).__cadenceUser = data;
      } catch {
        window.location.href = '/';
      }
    })();

    const today = document.getElementById('today');
    if (today) {
      const d = new Date();
      const day = String(d.getDate()).padStart(2, '0');
      const month = d.toLocaleString('en-GB', { month: 'short' }).toUpperCase();
      const year = d.getFullYear();
      today.textContent = `${day} ${month} ${year}`;
    }

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/logout', { method: 'POST' });
      window.location.href = '/';
    });
  </script>
</body>
</html>
