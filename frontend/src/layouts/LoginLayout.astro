---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Cadence' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Cadence</title>
  <meta name="description" content="Cadence — Timebeat internal operations console" />
</head>
<body class="h-full bg-surface-0 text-ink-primary">
  <slot />
</body>
</html>
