---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Cadence' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-GB" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/images/cadence-mark.svg" />
  <title>{title} — Cadence</title>
  <meta name="description" content="Cadence — agentic sales and operations console" />
</head>
<body class="ds-root h-full">
  <slot />
</body>
</html>
