---
/**
 * One call, seen by an admin.
 *
 * The same shared `AnalysisResult` every other call surface renders — the only
 * difference is the endpoint, which reaches across users, and the owner shown
 * beside the title. The fetch, the wait and both failure states belong to the
 * component; `endpoint` is the one thing this view has to say about them.
 *
 * **No `requires`, deliberately.** `requires` takes an *agent slug* — the shell
 * checks it with `canReach()`, which is `user.agents.includes(slug)`. There is no
 * `admin` agent, and passing `requires="calls"` would bounce an admin who does
 * not happen to hold the calls agent. The real guard is server-side on
 * `/api/admin/*`; `/admin` itself passes no `requires` for the same reason.
 */
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import AnalysisResult from '../../../components/AnalysisResult.astro';
---
<PlatformLayout title="Call">
  <div class="ds-page">
    <header class="ds-page__head">
      <p class="ds-eyebrow">Admin · calls</p>
      <h1 class="ds-heading ds-page__title" id="call-heading">Call analysis</h1>
      <p class="ds-mono page__when" id="when"></p>
      <span class="ds-mark ds-mark--idle" id="call-owner" hidden></span>
    </header>

    <AnalysisResult showClear={false} />
  </div>

  <style>
    /* Screen-level layout only. The head sits on `.ds-page`; the shared
       `AnalysisResult` carries its own styling. */
    .page__when { color: rgb(var(--ink-muted)); }
  </style>

  <script>
    import { el } from '../../../lib/dom';

    const id = new URLSearchParams(window.location.search).get('id');

    (window as any).loadAnalysis(id, {
      endpoint: '/api/admin/calls/',
      onSession(session: { title?: string; timestamp?: string; username?: string }) {
        const title = session.title || 'Call analysis';
        document.title = `${title} — Cadence`;
        el('call-heading').textContent = title;
        el('when').textContent = session.timestamp || '';

        // Whose call it is — the one thing this view adds over the others.
        if (session.username) {
          const owner = el('call-owner');
          owner.textContent = session.username;
          owner.hidden = false;
        }
      },
    });
  </script>
</PlatformLayout>
