---
/**
 * One call, seen by an admin.
 *
 * The same shared `AnalysisResult` every other call surface renders — the only
 * difference is the endpoint, which reaches across users, and the owner shown
 * beside the title.
 */
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import AnalysisResult from '../../../components/AnalysisResult.astro';
---
<PlatformLayout title="Call">
  <div class="ds-page">
    <header class="ds-page__head">
      <p class="ds-eyebrow">Admin · calls</p>
      <h1 class="ds-heading ds-page__title" id="call-heading">Call analysis</h1>
      <span class="ds-mark ds-mark--idle" id="call-owner" hidden></span>
    </header>

    <div class="ds-small state" id="load-state">loading analysis…</div>

    <AnalysisResult showClear={false} />
  </div>

  <style>
    /* Screen-level layout only. The head sits on `.ds-page`; the shared
       `AnalysisResult` carries its own styling. */
    .state { color: rgb(var(--ink-muted)); padding-block: var(--space-8); }
  </style>

  <script>
    const byId = (id: string) => document.getElementById(id)!;
    const id = new URLSearchParams(window.location.search).get('id');

    function fail(message: string): void {
      const state = byId('load-state');
      state.textContent = message;
      state.style.color = 'rgb(var(--signal-fault))';
    }

    if (!id) {
      fail('no call id provided');
    } else {
      fetch(`/api/admin/calls/${encodeURIComponent(id)}`)
        .then((r) => { if (!r.ok) throw new Error('not found'); return r.json(); })
        .then((session) => {
          const result = session.result || {};
          result._title = session.title || 'Call analysis';
          result._call_id = session.id;

          const label = (session.title || 'Call analysis')
            + (session.timestamp ? ' · ' + session.timestamp : '');
          byId('call-heading').textContent = session.title || 'Call analysis';

          // Whose call it is — the one thing this view adds over the others.
          if (session.username) {
            const owner = byId('call-owner');
            owner.textContent = session.username;
            owner.hidden = false;
          }

          (window as any).renderAnalysisResult(result);
          byId('ar-heading').textContent = label;
          byId('load-state').hidden = true;
        })
        .catch(() => fail('analysis not found'));
    }
  </script>
</PlatformLayout>
