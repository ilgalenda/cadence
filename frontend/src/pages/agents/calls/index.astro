---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { CALLS_AGENT_NAME, CALLS_AGENT_TAGLINE, CALLS_NAV } from '../../../agents/calls/config';

const areas = [
  { index: '01', href: '/agents/calls/products', title: 'Products', description: 'Hardware, software, and service portfolio — specs, pricing, and competitive angles.' },
  { index: '02', href: '/agents/calls/glossary?cat=protocols', title: 'Protocols', description: 'PTP, White Rabbit, SyncE, STL — the timing stack, explained in sales language.' },
  { index: '03', href: '/agents/calls/glossary', title: 'Terminology', description: 'Twenty-plus key terms and concepts with linked product references.' },
  { index: '04', href: '/agents/calls/analyze', title: 'Sales signals', description: 'Upload a call to surface buying signals, recommended products, and coaching prompts.' },
];

const quickRef = [
  'PTP', 'Grandmaster Clock', 'Clock Quorum', 'TaaS', 'vGMC',
  'White Rabbit', 'GNSS', 'SyncE', 'STL', 'OSNMA',
  'Boundary Clock', 'PNT', 'Consensus Algorithm',
];
---
<AgentLayout
  title="Overview"
  agentName={CALLS_AGENT_NAME}
  agentTagline={CALLS_AGENT_TAGLINE}
  navItems={CALLS_NAV}
>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · Calls"
      heading="Calls Support."
      lead="Knowledge, call intelligence, and reference — before, during, and after every call."
    >
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <!-- Stat strip -->
    <div class="grid grid-cols-4 border-y border-rule-strong mb-14">
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Calls analysed</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-calls">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Chat messages</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-chats">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Knowledge files</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-files">—</p>
      </div>
      <div class="px-5 py-5">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Total sessions</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-total">—</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-14">

      <!-- Areas -->
      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Areas</h2>
          <span class="font-mono text-[11px] tabular text-ink-muted">{areas.length.toString().padStart(2, '0')} total</span>
        </div>
        <ul>
          {areas.map(a => (
            <li>
              <a href={a.href} class="group grid grid-cols-[auto_1fr_auto] gap-8 items-start py-6 border-b border-rule-subtle hover:bg-surface-1 transition-colors duration-150 ease-decelerate -mx-4 px-4">
                <span class="font-mono text-xs tabular text-ink-muted pt-1">{a.index}</span>
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold tracking-tightest leading-tight group-hover:text-accent transition-colors duration-150 ease-decelerate">{a.title}</h3>
                  <p class="text-sm text-ink-secondary mt-1 leading-relaxed max-w-lg">{a.description}</p>
                </div>
                <span class="font-mono text-sm text-ink-muted group-hover:text-accent pt-1 transition-colors duration-150 ease-decelerate">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Activity -->
      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Recent activity</h2>
          <a href="/agents/calls/analysed" class="font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-accent transition-colors">View all →</a>
        </div>
        <ul id="recent-activity">
          <li class="py-6 font-mono text-xs text-ink-muted">// loading…</li>
        </ul>
      </section>

    </div>

    <!-- Quick reference -->
    <section class="mt-14">
      <div class="pb-3 mb-4 border-b border-rule-strong">
        <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Quick reference — key concepts</h2>
      </div>
      <p class="font-mono text-xs text-ink-secondary leading-loose">
        {quickRef.map((term, i) => (
          <>
            <a href={`/agents/calls/glossary#${encodeURIComponent(term)}`} class="hover:text-accent transition-colors">{term}</a>
            {i < quickRef.length - 1 && <span class="text-ink-muted"> · </span>}
          </>
        ))}
      </p>
    </section>

  </div>

  <script>
    async function loadStats() {
      try {
        const res = await fetch('/api/stats');
        const data = await res.json();
        const fmt = (n: number) => String(n).padStart(2, '0');
        document.getElementById('stat-calls')!.textContent = fmt(data.calls_analysed);
        document.getElementById('stat-chats')!.textContent = fmt(data.questions_asked);
        document.getElementById('stat-files')!.textContent = fmt(data.knowledge_files);
        document.getElementById('stat-total')!.textContent = fmt(data.sessions_total);
      } catch {}
    }

    async function loadActivity() {
      const el = document.getElementById('recent-activity')!;
      try {
        const res = await fetch('/api/sessions');
        const sessions = await res.json();
        if (!sessions.length) {
          el.innerHTML = '<li class="py-6 font-mono text-xs text-ink-muted">// no sessions yet</li>';
          return;
        }
        el.innerHTML = sessions.slice(0, 6).map((s: any) => {
          const isAnalysis = s.type === 'call_analysis';
          const inner = `
            <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-1">${s.timestamp} · ${isAnalysis ? 'ANALYSIS' : 'CHAT'}</p>
            <p class="text-sm text-ink-primary truncate leading-snug">${s.title}</p>
          `;
          return isAnalysis
            ? `<li class="border-b border-rule-subtle last:border-0">
                 <a href="/agents/calls/call?id=${encodeURIComponent(s.id)}" class="block py-3 hover:text-accent transition-colors">${inner}</a>
               </li>`
            : `<li class="py-3 border-b border-rule-subtle last:border-0">${inner}</li>`;
        }).join('');
      } catch {
        el.innerHTML = '<li class="py-6 font-mono text-xs text-signal-danger">// could not load activity</li>';
      }
    }

    loadStats();
    loadActivity();
  </script>
</AgentLayout>
