---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Toast from '../../../components/Toast.astro';
import { CALLS_AGENT_NAME, CALLS_AGENT_TAGLINE, CALLS_NAV } from '../../../agents/calls/config';
---
<AgentLayout
  title="Knowledge Base"
  agentName={CALLS_AGENT_NAME}
  agentTagline={CALLS_AGENT_TAGLINE}
  navItems={CALLS_NAV}
>
  <div class="px-10 py-12 max-w-4xl">

    <PageHeader
      label="Calls · Knowledge base"
      heading="Knowledge base."
      lead="Documents Claude reads on every chat and analysis. Upload competitive intel, case studies, or pricing sheets."
    >
      <span slot="meta" id="files-count">—</span>
    </PageHeader>

    <!-- Read-only banner (non-admin) -->
    <div id="readonly-banner" class="hidden mb-4 px-4 py-3 border border-rule-subtle bg-surface-1 rounded-sm">
      <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted">// read-only — admin access required to upload or delete</p>
    </div>

    <!-- Upload control -->
    <div class="flex items-center justify-between pb-3 mb-2 border-b border-rule-strong">
      <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Files</h2>
      <label id="upload-control" class="cursor-pointer group flex items-center gap-2 bg-surface-ink text-ink-inverse hover:bg-accent px-4 py-2 rounded-sm text-sm font-medium transition-colors duration-150 ease-decelerate">
        <span>Upload file</span>
        <span class="font-mono">→</span>
        <input id="file-input" type="file" accept=".md,.txt" class="hidden" />
      </label>
    </div>

    <!-- Upload progress (inline hairline row) -->
    <div id="upload-progress" class="hidden border-b border-rule-subtle py-3 flex items-center gap-3">
      <span class="inline-block w-3 h-3 border border-accent border-t-transparent rounded-full animate-spin"></span>
      <span id="upload-filename" class="font-mono text-xs text-ink-secondary">Uploading…</span>
    </div>

    <!-- File list -->
    <ul id="files-list">
      <li class="py-6 text-sm text-ink-muted">Loading files…</li>
    </ul>

    <!-- Empty -->
    <div id="empty-state" class="hidden py-16">
      <p class="font-mono text-xs text-ink-muted">// no files yet</p>
      <p class="text-sm text-ink-secondary mt-2">Upload a .md or .txt file to get started.</p>
    </div>

    <!-- Info -->
    <div class="mt-12 pt-6 border-t border-rule-subtle">
      <p class="font-mono text-[11px] text-ink-muted leading-relaxed">
        Supported: <span class="text-ink-secondary">.md</span> · <span class="text-ink-secondary">.txt</span> &nbsp;·&nbsp;
        Loaded into Claude's context on every chat and analysis &nbsp;·&nbsp;
        <span class="text-ink-secondary">timebeat-ivos.md</span> is protected and cannot be deleted.
      </p>
    </div>

    <!-- Static safelist for classes injected by JS below -->
    <div class="hidden" aria-hidden="true">
      <span class="hover:bg-surface-2"></span>
      <span class="hover:text-accent"></span>
    </div>

  </div>

  <Toast />

  <script>
    type FileItem = { name: string; size_kb: number; modified: string; protected: boolean };
    let files: FileItem[] = [];
    let isAdmin = false;

    (async () => {
      try {
        const res = await fetch('/api/auth/status');
        const data = await res.json();
        isAdmin = data.access === 'admin';
        if (!isAdmin) {
          document.getElementById('upload-control')?.classList.add('hidden');
          document.getElementById('readonly-banner')?.classList.remove('hidden');
        }
      } catch {}
    })();

    function formatSize(kb: number) {
      if (kb < 1) return '< 1 KB';
      if (kb < 1024) return `${kb} KB`;
      return `${(kb / 1024).toFixed(1)} MB`;
    }

    function renderFiles() {
      const list = document.getElementById('files-list')!;
      const empty = document.getElementById('empty-state')!;
      const count = document.getElementById('files-count')!;

      count.textContent = `${files.length.toString().padStart(2, '0')} files`;

      if (!files.length) {
        list.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      list.innerHTML = files.map(f => `
        <li class="grid grid-cols-[auto_1fr_auto_auto_auto] gap-6 items-center py-4 border-b border-rule-subtle hover:bg-surface-2 transition-colors duration-150 ease-decelerate px-2 -mx-2">
          <span class="font-mono text-sm text-ink-muted">${f.protected ? '●' : '○'}</span>
          <p class="text-sm font-medium text-ink-primary truncate">${f.name}</p>
          <p class="font-mono text-xs tabular text-ink-muted">${formatSize(f.size_kb)}</p>
          <p class="font-mono text-xs tabular text-ink-muted">${f.modified}</p>
          <div class="w-24 text-right">
            ${f.protected
              ? `<span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Protected</span>`
              : (isAdmin
                ? `<button class="delete-btn font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-accent transition-colors duration-150" data-name="${f.name}">Delete →</button>`
                : ''
              )
            }
          </div>
        </li>
      `).join('');

      document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => deleteFile(btn.dataset.name!));
      });
    }

    async function loadFiles() {
      try {
        const res = await fetch('/api/knowledge');
        if (!res.ok) throw new Error();
        files = await res.json();
        renderFiles();
      } catch {
        document.getElementById('files-list')!.innerHTML =
          '<li class="py-8 text-sm text-signal-danger font-mono">// failed to load — is the backend running?</li>';
      }
    }

    async function deleteFile(name: string) {
      if (!confirm(`Delete "${name}"?`)) return;
      try {
        const res = await fetch(`/api/knowledge/${encodeURIComponent(name)}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) { (window as any).toast('danger', data.detail || 'Delete failed'); return; }
        (window as any).toast('success', `Deleted ${name}`);
        files = files.filter(f => f.name !== name);
        renderFiles();
      } catch {
        (window as any).toast('danger', 'Delete failed');
      }
    }

    document.getElementById('file-input')!.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      input.value = '';

      const progress = document.getElementById('upload-progress')!;
      document.getElementById('upload-filename')!.textContent = `Uploading ${file.name}…`;
      progress.classList.remove('hidden');

      const form = new FormData();
      form.append('file', file);

      try {
        const res = await fetch('/api/knowledge/upload', { method: 'POST', body: form });
        const data = await res.json();
        progress.classList.add('hidden');
        if (!res.ok) { (window as any).toast('danger', data.detail || 'Upload failed'); return; }
        (window as any).toast('success', `Uploaded ${file.name}`);
        await loadFiles();
      } catch {
        progress.classList.add('hidden');
        (window as any).toast('danger', 'Upload failed');
      }
    });

    loadFiles();
  </script>
</AgentLayout>
