---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Tabs from '../../../components/Tabs.astro';
import { CALLS_AGENT_NAME, CALLS_AGENT_TAGLINE, CALLS_NAV } from '../../../agents/calls/config';
---
<AgentLayout
  title="Products"
  agentName={CALLS_AGENT_NAME}
  agentTagline={CALLS_AGENT_TAGLINE}
  navItems={CALLS_NAV}
>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Calls · Products"
      heading="Products & solutions."
      lead="Complete Timebeat portfolio — hardware, software, cloud, and services. Browse by category or industry vertical."
    />

    <!-- View toggle -->
    <div class="mb-10">
      <Tabs
        group="products-view"
        active="category"
        tabs={[
          { id: 'category', label: 'By category' },
          { id: 'vertical', label: 'By vertical' },
        ]}
      />
    </div>

    <!-- Category view -->
    <div id="view-category-panel">
      <section class="mb-14">
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Hardware</h2>
          <span class="font-mono text-[11px] tabular text-ink-muted" id="hw-count">—</span>
        </div>
        <ul id="hw-list"></ul>
      </section>

      <section class="mb-14">
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Software & cloud</h2>
          <span class="font-mono text-[11px] tabular text-ink-muted" id="sw-count">—</span>
        </div>
        <ul id="sw-list"></ul>
      </section>

      <section class="mb-14">
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Professional services</h2>
          <span class="font-mono text-[11px] tabular text-ink-muted" id="svc-count">—</span>
        </div>
        <ul id="svc-list"></ul>
      </section>
    </div>

    <!-- Vertical view -->
    <div id="view-vertical-panel" class="hidden">
      <div id="verticals-list"></div>
    </div>

    <!-- Static safelist for JS-injected classes -->
    <div class="hidden" aria-hidden="true">
      <span class="bg-accent-soft"></span>
    </div>

  </div>

  <script>
    // ── Data (unchanged from previous version) ─────────────────────────────

    const HARDWARE = [
      { name: "Open Time Appliance", slug: "open-time-appliance", badge: "Best seller", tagline: "Self-verifying grandmaster with Clock Quorum consensus.", description: "The flagship rackmount grandmaster clock. Combines hardware precision with Timebeat's consensus algorithm — cross-checking multiple time sources to prove accuracy rather than just claim it.", specs: ["< 5ns accuracy", "IEEE-1588 PTP + NTP output", "GNSS + STL input", "Clock Quorum Technology"], pricing: "From £3,995", ideal: "Data centres, colocation, telecoms, enterprises.", verticals: ["Finance & Trading", "Telecom & 5G", "Data Centre"], competitive: "Competitors sell grandmasters. Timebeat sells a self-verifying timing network. The consensus is the moat." },
      { name: "Open Time Appliance Mini", slug: "open-time-appliance-mini", badge: "Entry level", tagline: "Compact grandmaster for edge and SMB deployments.", description: "All the precision of the full appliance in a compact form factor. Ideal for edge sites, smaller deployments, and cost-sensitive environments.", specs: ["IEEE-1588 PTP + NTP", "GNSS input", "Compact form factor"], pricing: "From £1,395", ideal: "5G edge, broadcast, IoT, automotive, Industry 4.0.", verticals: ["Telecom & 5G", "Broadcast & Media", "IoT & Automotive", "Industry 4.0"], competitive: "Lower cost entry into Timebeat's self-verifying ecosystem. Same software stack as the full appliance." },
      { name: "Open Time Server", slug: "open-time-server", badge: "Enterprise", tagline: "Rack-mounted IEEE-1588 grandmaster. Hyperscale throughput.", description: "Turn-key enterprise grandmaster server with modular design. Supports 1/10/25/100/200GbE network speeds. Built-in anti-jam and anti-spoof for defence-grade deployments.", specs: ["1 / 10 / 25 / 100 / 200 GbE", "IEEE-1588 PTP + NTP + SyncE", "Anti-jam & anti-spoof", "Modular, field-upgradable"], pricing: "From £5,995", ideal: "Hyperscale, cloud providers, defence, finance.", verticals: ["Finance & Trading", "Government & Defence", "Data Centre", "Telecom & 5G"], competitive: "Higher network speed than standalone grandmasters by leveraging host NIC. Scales with the server." },
      { name: "Open Timecard", slug: "open-timecard", badge: "PCIe card", tagline: "Grandmaster inside your server. Infrastructure-owned timing.", description: "A fully-fledged grandmaster on a PCIe card. Has its own compute and network ports — can be standalone or integrated with the host. Goes under the customer's ownership and control.", specs: ["1 Gbps", "PCIe form factor", "GNSS input", "1Hz–1GHz frequency range", "Anti-spoof / anti-jam"], pricing: "From £2,995", ideal: "Defence, consultancy integrations, sovereignty-sensitive enterprises.", verticals: ["Government & Defence", "Finance & Trading"], competitive: "Goes inside the customer's server — their ownership, their control. Critical for strict sovereignty requirements." },
      { name: "Open Timecard Mini 2.0", slug: "open-timecard-mini", badge: "Compact module", tagline: "Modular timing for edge, IoT and embedded deployments.", description: "Mini-module ecosystem with four variants: Precision Timing, Precision Location, Precision Timing Lite, and Essential. Designed for compact, cost-effective deployments at the edge.", specs: ["4 module variants", "Precision Timing firmware v3.14", "Edge-optimised form factor"], pricing: "From £324.95", ideal: "5G edge, IoT, automotive OEM, industrial embedded.", verticals: ["Telecom & 5G", "IoT & Automotive", "Industry 4.0"], competitive: "Lowest cost entry into the Timebeat ecosystem. OEM-friendly for embedded integrations." },
      { name: "OCP-TAP Timecard", slug: "ocp-tap-timecard", badge: "Open standards", tagline: "Hyperscaler-trusted OCP grandmaster PCIe card.", description: "PCIe GNSS grandmaster built to the Open Compute Project (OCP) standard. Community-driven, trusted by hyperscalers. Outputs NMEA, 1PPS, 10MHz.", specs: ["OCP-TAP standard", "NMEA + 1PPS + 10MHz outputs", "GNSS grandmaster"], pricing: "From £2,495", ideal: "Hyperscale, open infrastructure.", verticals: ["Data Centre", "Finance & Trading"], competitive: "Hyperscaler credibility from OCP standard. Open ecosystem with maximum interoperability." },
      { name: "Open Time Node WR", slug: "open-time-node-wr", badge: "White Rabbit", tagline: "Sub-nanosecond edge timing. Part of the White Rabbit ecosystem.", description: "Compact edge unit delivering sub-nanosecond precision as part of the full White Rabbit ecosystem. Distributes timing over fibre up to 100km.", specs: ["Sub-nanosecond accuracy", "Fibre up to 100km", "PTP + SyncE combined"], pricing: "Contact sales", ideal: "HFT, defence, scientific research, quantum computing.", verticals: ["Finance & Trading", "Government & Defence", "Scientific Research"], competitive: "Most vendors stop at microseconds. White Rabbit operates in picoseconds — a completely different league." },
    ];

    const SOFTWARE = [
      { name: "Timebeat App", slug: "timebeat-app", badge: "Free", tagline: "Free NTP & PTP synchronisation software. 10–12 dashboards.", description: "The core Timebeat synchronisation software. Free to download. Richest monitoring dashboard in the market. Supports NTP, IEEE-1588 PTP, and frequency synchronisation.", specs: ["10–12 monitoring dashboards", "NTP + PTP + frequency sync", "Linux + Windows", "90-day free enterprise trial"], pricing: "Free · Support sold separately", ideal: "Any org running PTP/NTP infrastructure wanting visibility.", verticals: ["Finance & Trading", "Telecom & 5G", "Data Centre", "Government & Defence"], competitive: "Software-first origins — dashboard experience is significantly richer than hardware-centric competitors." },
      { name: "Timebeat Sync Insight", slug: "sync-insight", badge: "SaaS", tagline: "Managed monitoring & visualisation for sync infrastructure.", description: "Cloud-based SaaS monitoring platform. Metric-rich dashboards, real-time visibility, anomaly detection, verifiable SLA evidence. Single-click provisioning.", specs: ["Real-time anomaly detection", "PTP + NTP + GNSS + NMEA input", "Single-click provisioning", "Automated alerting"], pricing: "Usage-based · Contact sales", ideal: "TaaS providers, large enterprises, test/dev labs.", verticals: ["Finance & Trading", "Telecom & 5G", "Data Centre"], competitive: "Managed hosting removes the ops burden. SLA evidence built-in — critical for compliance-driven industries." },
      { name: "PTP+Squared (IEEE-1588 Quorum)", slug: "ptp-squared", badge: "Resilience", tagline: "Mesh-based PTP that eliminates single points of failure.", description: "Resilient mesh synchronisation using clock quorum techniques. Addresses the failure points of traditional PTP tree architectures. Works over LAN and WAN.", specs: ["Mesh-based", "LAN + WAN support", "Consensus algorithm", "PTP tree replacement"], pricing: "Included with Timebeat software", ideal: "Any regulated or critical environment.", verticals: ["Finance & Trading", "Government & Defence", "Telecom & 5G", "Energy & Infrastructure"], competitive: "Standard PTP breaks at the root. PTP+Squared is self-healing — an industry-first approach to resilient timing." },
      { name: "Time-as-a-Service (TaaS)", slug: "taas", badge: "Cloud", tagline: "Managed PTP feeds for service providers. No switch port limits.", description: "Multi-tenant PTP distribution as a managed service. Enables service providers to offer precise timing feeds to clients without traditional infrastructure constraints.", specs: ["Multi-tenant PTP distribution", "No switch port limitations", "Template configurations", "Segregated client feeds"], pricing: "Contact sales", ideal: "Telecoms, colocation, MSPs building recurring timing revenue.", verticals: ["Telecom & 5G", "Data Centre", "Finance & Trading"], competitive: "AWS is to servers what TaaS is to timing. Removes capex barrier; creates predictable recurring revenue." },
      { name: "Clock Sync Verification", slug: "clock-sync-verification", badge: "Compliance", tagline: "Validate PTP and NTP feeds. SLA and compliance evidence.", description: "Validation and verification service for precision time protocol and NTP feeds. Enhances SLAs with verifiable accuracy evidence.", specs: ["PTP + NTP + frequency verification", "SLA evidence generation", "Compliance reporting", "Anomaly audit trail"], pricing: "Included with Sync Insight", ideal: "Finance (MiFID II), telecoms, compliance-driven.", verticals: ["Finance & Trading", "Government & Defence", "Energy & Infrastructure"], competitive: "Turns timing accuracy from a claim into verifiable evidence — the difference between passing and failing a compliance audit." },
    ];

    const SERVICES = [
      { name: "Synchronisation Consultancy", slug: "consultancy", badge: "Advisory", tagline: "Expert guidance on precision timing architecture.", description: "End-to-end consulting: architecture design, implementation guidance, system optimisation, 24/7 incident management, hardware lifecycle management, failover testing.", specs: ["Architecture design", "24/7 incident management", "Hardware lifecycle management", "Failover & environmental testing"], pricing: "Contact sales", ideal: "Enterprises and govts deploying complex timing infrastructure.", verticals: ["Government & Defence", "Finance & Trading", "Telecom & 5G"], competitive: "Timebeat's engineers built the products — consultancy directly from the source, not a third-party integrator." },
      { name: "Enterprise Support", slug: "enterprise-support", badge: "24/7", tagline: "Premium 24/7 incident management and patch deployment.", description: "Annual support subscription covering 24/7 incident management, patch deployment, configuration tuning, onsite support.", specs: ["24/7 incident management", "Patch deployment", "Configuration optimisation", "Onsite support available"], pricing: "Annual · Contact sales", ideal: "Enterprises requiring guaranteed uptime SLAs.", verticals: ["Finance & Trading", "Government & Defence", "Telecom & 5G", "Energy & Infrastructure"], competitive: "Direct vendor support — no intermediary, faster resolution, engineers who built the product." },
      { name: "Annual Hardware Support", slug: "hw-support", badge: "Maintenance", tagline: "Hardware lifecycle, diagnostics and calibration.", description: "Hardware diagnostics, lifecycle management, calibration, and failover testing. Protects your hardware investment and ensures ongoing accuracy certification.", specs: ["Hardware diagnostics", "Calibration", "Lifecycle management", "Failover testing"], pricing: "Contact sales", ideal: "Any org with deployed Timebeat hardware.", verticals: ["Finance & Trading", "Government & Defence", "Data Centre"], competitive: "Factory-calibrated by the manufacturer. Independent calibration services cannot match source calibration." },
    ];

    const VERTICALS = [
      { name: "Finance & Trading", description: "MiFID II compliance, sub-microsecond timestamping, resilient timing for trading systems that can't afford a missed tick.", products: ["Open Time Appliance", "Open Timecard", "Open Time Server", "PTP+Squared (IEEE-1588 Quorum)", "Clock Sync Verification", "Open Time Node WR"], useCases: ["MiFID II timestamp compliance", "HFT infrastructure (sub-ns via White Rabbit)", "Trading system synchronisation", "Audit-trail timestamping"] },
      { name: "Telecom & 5G / O-RAN", description: "Fastest-growing sector for Timebeat. IEEE-1588 PTP for distributed 5G and O-RAN architectures.", products: ["Open Time Appliance", "Open Time Appliance Mini", "Open Timecard Mini 2.0", "Time-as-a-Service (TaaS)", "Timebeat App"], useCases: ["5G base station sync", "O-RAN fronthaul timing", "TaaS for mobile operators", "Private 5G networks"] },
      { name: "Government & Defence", description: "GPS-denied and GPS-contested environments. Anti-jam, anti-spoof, resilient PNT for mission-critical communications.", products: ["Open Timecard", "Open Time Server", "Open Time Node WR", "PTP+Squared (IEEE-1588 Quorum)", "Synchronisation Consultancy"], useCases: ["GPS-denied timing (STL fallback)", "Anti-spoof / anti-jam infrastructure", "Resilient PNT for field comms", "Zero-trust multi-source timing"] },
      { name: "Data Centre & Cloud", description: "Grandmaster timing for hyperscale and colocation. TaaS to monetise timing as a service to tenants.", products: ["Open Time Appliance", "Open Time Server", "OCP-TAP Timecard", "Time-as-a-Service (TaaS)", "Timebeat Sync Insight"], useCases: ["Colocation timing services", "Hyperscale PTP distribution", "TaaS for data centre tenants", "SLA monitoring and evidence"] },
      { name: "Broadcast & Media", description: "Frame-accurate synchronisation for live broadcast, cloud TV, and interactive sports analytics.", products: ["Open Time Appliance Mini", "Timebeat App", "Timebeat Sync Insight"], useCases: ["Live broadcast synchronisation", "Cloud mobile TV", "Interactive sports analytics", "Media distribution timestamping"] },
      { name: "Energy & Critical Infrastructure", description: "Grid synchronisation, SCADA timestamping, and resilient timing for power infrastructure that cannot go down.", products: ["Open Time Appliance", "PTP+Squared (IEEE-1588 Quorum)", "Clock Sync Verification", "Enterprise Support"], useCases: ["Power grid synchronisation", "SCADA system timing", "Fault detection timestamps", "Compliance evidence for regulators"] },
      { name: "IoT & Automotive", description: "Deterministic timing for autonomous vehicles, connected sensors, and Industry 4.0 automation.", products: ["Open Timecard Mini 2.0", "Open Time Appliance Mini", "Timebeat App"], useCases: ["Autonomous vehicle timing", "Industrial sensor synchronisation", "Industry 4.0 automation", "OEM embedded timing modules"] },
    ];

    // ── Render helpers ─────────────────────────────────────────────────────

    function esc(s: unknown) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function productRow(p: any, index: string) {
      return `
        <li id="${esc(p.slug)}" class="group grid grid-cols-[auto_1fr_auto] gap-8 items-start py-6 border-b border-rule-subtle scroll-mt-8 transition-colors duration-300 ease-decelerate">
          <span class="font-mono text-xs tabular text-ink-muted pt-1">${index}</span>
          <div class="min-w-0">
            <div class="flex items-baseline gap-3 flex-wrap mb-1">
              <h3 class="text-lg font-semibold tracking-tightest leading-tight">${esc(p.name)}</h3>
              <span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">${esc(p.badge)}</span>
            </div>
            <p class="text-sm text-ink-secondary leading-relaxed max-w-2xl">${esc(p.description)}</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
              <div>
                <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-1.5">Key specs</p>
                <ul class="space-y-0.5">
                  ${p.specs.slice(0, 4).map((s: string) => `<li class="text-xs text-ink-secondary leading-relaxed">· ${esc(s)}</li>`).join('')}
                </ul>
              </div>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-1.5">Ideal for</p>
                <p class="text-xs text-ink-secondary leading-relaxed">${esc(p.ideal)}</p>
              </div>
            </div>
            <div class="relative bg-surface-1 border border-rule-subtle pl-4 pr-4 py-3 mt-4 max-w-2xl">
              <span class="absolute left-0 top-0 bottom-0 w-[2px] bg-accent"></span>
              <p class="text-xs text-ink-secondary italic leading-relaxed">${esc(p.competitive)}</p>
            </div>
            <div class="flex items-center justify-between mt-4 flex-wrap gap-3">
              <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted">
                ${p.verticals.map((v: string) => esc(v)).join(' · ')}
              </p>
              <button class="ask-btn font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-accent transition-colors" data-product="${esc(p.name)}">ask claude →</button>
            </div>
          </div>
          <div class="text-right pt-1">
            <p class="font-mono text-sm tabular text-ink-primary whitespace-nowrap">${esc(p.pricing)}</p>
          </div>
        </li>
      `;
    }

    function renderCategories() {
      const fmt = (n: number) => `${String(n).padStart(2, '0')} items`;
      document.getElementById('hw-list')!.innerHTML = HARDWARE.map((p, i) => productRow(p, String(i + 1).padStart(2, '0'))).join('');
      document.getElementById('sw-list')!.innerHTML = SOFTWARE.map((p, i) => productRow(p, String(i + 1).padStart(2, '0'))).join('');
      document.getElementById('svc-list')!.innerHTML = SERVICES.map((p, i) => productRow(p, String(i + 1).padStart(2, '0'))).join('');
      document.getElementById('hw-count')!.textContent = fmt(HARDWARE.length);
      document.getElementById('sw-count')!.textContent = fmt(SOFTWARE.length);
      document.getElementById('svc-count')!.textContent = fmt(SERVICES.length);
      attachAskButtons();
    }

    function renderVerticals() {
      const allProducts = [...HARDWARE, ...SOFTWARE, ...SERVICES];
      const byName = Object.fromEntries(allProducts.map(p => [p.name, p]));

      document.getElementById('verticals-list')!.innerHTML = VERTICALS.map((v, i) => `
        <section class="mb-12">
          <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
            <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">${esc(v.name)}</h2>
            <span class="font-mono text-[11px] tabular text-ink-muted">${String(i + 1).padStart(2, '0')} / ${String(VERTICALS.length).padStart(2, '0')}</span>
          </div>
          <div class="py-5 border-b border-rule-subtle">
            <p class="text-sm text-ink-secondary leading-relaxed max-w-2xl mb-6">${esc(v.description)}</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
              <div>
                <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Use cases</p>
                <ul class="space-y-1">
                  ${v.useCases.map((u: string) => `<li class="text-sm text-ink-secondary leading-relaxed">→ ${esc(u)}</li>`).join('')}
                </ul>
              </div>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Recommended products</p>
                <ul class="space-y-1">
                  ${v.products.map((pName: string) => {
                    const p = (byName as any)[pName];
                    return p
                      ? `<li><a href="#${esc(p.slug)}" onclick="switchToCategory()" class="text-sm text-ink-primary hover:text-accent transition-colors font-mono">→ ${esc(pName)}</a></li>`
                      : `<li class="text-sm text-ink-muted font-mono">→ ${esc(pName)}</li>`;
                  }).join('')}
                </ul>
              </div>
            </div>
          </div>
        </section>
      `).join('');
    }

    function attachAskButtons() {
      document.querySelectorAll<HTMLButtonElement>('.ask-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const q = `Give me a full sales briefing on "${btn.dataset.product}": key differentiators, ideal customer profile, common objections and how to handle them, and the best competitive angles.`;
          window.location.href = `/agents/calls/chat?q=${encodeURIComponent(q)}`;
        });
      });
    }

    // ── View toggle (driven by Tabs partial custom event) ──────────────────

    function setView(view: 'category' | 'vertical') {
      const isCategory = view === 'category';
      document.getElementById('view-category-panel')!.classList.toggle('hidden', !isCategory);
      document.getElementById('view-vertical-panel')!.classList.toggle('hidden', isCategory);
    }

    (window as any).switchToCategory = () => {
      setView('category');
      // Update the Tabs visual state
      const group = document.querySelector<HTMLDivElement>('[data-tab-group="products-view"]');
      group?.querySelector<HTMLButtonElement>('[data-tab="category"]')?.click();
    };

    document.addEventListener('tab-change', (e: any) => {
      if (!e.target?.dataset || e.target.dataset.tabGroup !== 'products-view') return;
      setView(e.detail.id as 'category' | 'vertical');
    });

    // ── Init ───────────────────────────────────────────────────────────────

    renderCategories();
    renderVerticals();

    const hash = decodeURIComponent(window.location.hash.slice(1));
    if (hash) {
      setTimeout(() => {
        const el = document.getElementById(hash);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          el.classList.add('bg-accent-soft');
          setTimeout(() => el.classList.remove('bg-accent-soft'), 1800);
        }
      }, 120);
    }
  </script>
</AgentLayout>
