---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { CALLS_AGENT_NAME, CALLS_AGENT_TAGLINE, CALLS_NAV } from '../../../agents/calls/config';
---
<AgentLayout
  title="Quiz"
  agentName={CALLS_AGENT_NAME}
  agentTagline={CALLS_AGENT_TAGLINE}
  navItems={CALLS_NAV}
>
  <div class="px-10 py-12 max-w-3xl">

    <PageHeader
      label="Calls · Quiz"
      heading="Knowledge quiz."
      lead="Questions drawn from real-world call scenarios and anonymised. Every call analysed by the team sharpens the pool."
    >
      <span slot="meta" id="pool-stat">—</span>
    </PageHeader>

    <!-- Generate section -->
    <div id="generate-section" class="mt-10">
      <div class="flex items-center gap-6">
        <button
          id="generate-btn"
          class="px-5 py-2.5 bg-accent text-white font-mono text-xs uppercase tracking-label rounded hover:opacity-90 transition-opacity"
        >
          Generate Quiz →
        </button>
        <span id="gen-status" class="hidden font-mono text-xs text-ink-muted">// generating…</span>
      </div>
    </div>

    <!-- Question Bank (section-level accordion) -->
    <section id="bank-section" class="mt-14">
      <button id="bank-toggle" type="button" class="w-full flex items-center justify-between gap-6 pb-2 border-b border-rule-strong text-left hover:opacity-80 transition-opacity">
        <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Question Bank</h2>
        <div class="flex items-center gap-3">
          <span id="bank-count" class="font-mono text-[11px] uppercase tracking-label text-ink-muted">—</span>
          <span id="bank-chev" class="font-mono text-sm text-ink-muted transition-transform">▸</span>
        </div>
      </button>
      <div id="bank-body" class="hidden mt-6 space-y-4">
        <p class="py-8 text-center font-mono text-xs text-ink-muted">// loading…</p>
      </div>
    </section>

    <!-- Newsletter Quiz -->
    <section id="newsletter-section" class="mt-14">
      <div class="flex items-baseline justify-between mb-4 pb-2 border-b border-rule-strong">
        <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Newsletter Quiz</h2>
      </div>
      <p class="text-sm text-ink-secondary leading-relaxed mb-6">Generate 1–3 educational MCQs for newsletters — mostly general timing concepts, occasionally Timebeat-anchored. Copy the HTML snippet straight into your newsletter editor.</p>

      <div class="flex flex-wrap items-center gap-4 mb-6">
        <div id="news-count" class="inline-flex rounded border border-rule-subtle overflow-hidden font-mono text-xs">
          <button type="button" data-news-count="1" class="news-count-btn px-3 py-1.5 border-r border-rule-subtle">1</button>
          <button type="button" data-news-count="2" class="news-count-btn px-3 py-1.5 border-r border-rule-subtle">2</button>
          <button type="button" data-news-count="3" class="news-count-btn px-3 py-1.5">3</button>
        </div>
        <button
          id="news-generate-btn"
          class="px-5 py-2.5 bg-accent text-white font-mono text-xs uppercase tracking-label rounded hover:opacity-90 transition-opacity"
        >
          Generate newsletter quiz →
        </button>
        <span id="news-status" class="hidden font-mono text-xs text-ink-muted">// generating…</span>
      </div>

      <div id="news-output" class="space-y-4"></div>
      <div id="news-copy-all-wrap" class="hidden mt-6">
        <button
          id="news-copy-all-btn"
          class="px-5 py-2.5 font-mono text-xs uppercase tracking-label border border-rule-strong text-ink-secondary rounded hover:bg-surface-2 transition-colors"
        >
          Copy all HTML →
        </button>
      </div>
    </section>

    <!-- Quiz (hidden until generated) -->
    <div id="quiz-container" class="hidden mt-10">

      <!-- Progress -->
      <div class="mb-8">
        <div class="flex justify-between items-center mb-2">
          <span id="progress-label" class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Question 1 / 10</span>
          <span id="score-running" class="font-mono text-[11px] uppercase tracking-label text-ink-muted"></span>
        </div>
        <div class="h-0.5 bg-surface-2 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-accent transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- Question card -->
      <div id="question-card" class="bg-surface-1 border border-rule-subtle rounded p-8">
        <p id="question-text" class="text-base font-semibold text-ink-primary mb-6 leading-relaxed"></p>
        <div id="options-list" class="space-y-3"></div>
        <div id="feedback-block" class="hidden mt-6 pt-6 border-t border-rule-subtle">
          <p id="feedback-verdict" class="font-mono text-xs uppercase tracking-label mb-2"></p>
          <p id="feedback-explanation" class="text-sm text-ink-secondary leading-relaxed"></p>
        </div>
        <div class="mt-8 flex justify-end">
          <button
            id="next-btn"
            class="hidden px-5 py-2.5 font-mono text-xs uppercase tracking-label bg-accent text-white rounded hover:opacity-90 transition-opacity"
          >
            Next →
          </button>
        </div>
      </div>
    </div>

    <!-- Score screen (hidden until complete) -->
    <div id="score-screen" class="hidden mt-10">
      <div class="bg-surface-1 border border-rule-subtle rounded p-8 mb-8">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-3">Result</p>
        <p id="final-score" class="text-4xl font-semibold text-ink-primary"></p>
        <p id="final-verdict" class="font-mono text-sm uppercase tracking-label mt-2"></p>
        <button
          id="retake-btn"
          class="mt-6 px-5 py-2.5 font-mono text-xs uppercase tracking-label border border-rule-strong text-ink-secondary rounded hover:bg-surface-2 transition-colors"
        >
          Retake →
        </button>
      </div>
      <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-4">Review</p>
      <div id="review-list" class="space-y-4"></div>
    </div>

  </div>

  <script>
    type McqQuestion = {
      type: 'mcq';
      question: string;
      options: string[];
      correct: number;
      explanation: string;
    };

    type FlashcardQuestion = {
      type: 'flashcard';
      question: string;
      answer: string;
    };

    type QuizQuestion = McqQuestion | FlashcardQuestion;

    type McqAnswer = { kind: 'mcq'; chosen: number; correct: boolean };
    type FlashcardAnswer = { kind: 'flashcard'; gotIt: boolean; typed: string };
    type QuizAnswer = McqAnswer | FlashcardAnswer;

    type QuizSource = { kind: 'generated' } | { kind: 'call'; callIndex: number };

    type QuizState = {
      questions: QuizQuestion[];
      current: number;
      answers: (QuizAnswer | null)[];
      source: QuizSource;
    };

    let state: QuizState | null = null;

    function esc(s: string) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    type BankQuestion = QuizQuestion;

    type BankCall = {
      id: string;
      title: string;
      timestamp: string;
      questions: BankQuestion[];
      concepts: string[];
    };

    let bankCalls: BankCall[] = [];

    let bankRendered = false;

    async function loadPoolStats() {
      try {
        const res = await fetch('/api/quiz/pool');
        if (!res.ok) return;
        const data = await res.json();
        const el = document.getElementById('pool-stat');
        if (el) el.textContent = `${data.total_calls} call${data.total_calls !== 1 ? 's' : ''} in pool`;
        bankCalls = Array.isArray(data.calls) ? data.calls : [];
        updateBankCount();
        if (!document.getElementById('bank-body')!.classList.contains('hidden')) {
          renderBankBody();
        }
      } catch { /* silently ignore */ }
    }

    function updateBankCount() {
      const count = document.getElementById('bank-count')!;
      count.textContent = `${bankCalls.length} call${bankCalls.length !== 1 ? 's' : ''}`;
    }

    function renderBankBody() {
      const body = document.getElementById('bank-body')!;
      if (!bankCalls.length) {
        body.innerHTML = '<p class="py-8 text-center font-mono text-xs text-ink-muted">// no quizzes yet — analyse a call to start building the bank</p>';
        bankRendered = true;
        return;
      }

      body.innerHTML = bankCalls.map((c, ci) => `
        <div class="bg-surface-1 border border-rule-subtle rounded overflow-hidden">
          <button type="button" data-call-toggle="${ci}" class="w-full flex items-center justify-between gap-4 px-5 py-4 hover:bg-surface-2 transition-colors text-left">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-ink-primary truncate">${esc(c.title)}</p>
              <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mt-1">${esc(c.timestamp)} · ${c.questions.length} question${c.questions.length !== 1 ? 's' : ''}</p>
            </div>
            <span class="call-chev font-mono text-sm text-ink-muted transition-transform">▸</span>
          </button>
          <div data-call-body="${ci}" class="hidden px-5 pb-5 pt-5 border-t border-rule-subtle"></div>
        </div>
      `).join('');
      bankRendered = true;
    }

    function renderCallBody(ci: number) {
      const body = document.querySelector<HTMLElement>(`[data-call-body="${ci}"]`);
      if (!body || body.dataset.rendered) return;
      const call = bankCalls[ci];
      const conceptsBlock = call.concepts.length
        ? `<div class="flex flex-wrap gap-2 mb-5">
             ${call.concepts.map(c => `<span class="px-2 py-1 font-mono text-[11px] uppercase tracking-label text-ink-secondary border border-rule-subtle rounded">${esc(c)}</span>`).join('')}
           </div>`
        : `<p class="text-sm text-ink-muted mb-5">// no topic summary available for this call</p>`;
      body.innerHTML = `
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-3">Covers</p>
        ${conceptsBlock}
        <div class="flex justify-end">
          <button type="button" data-take-call="${ci}" class="px-4 py-2 font-mono text-[11px] uppercase tracking-label bg-accent text-white rounded hover:opacity-90 transition-opacity">
            Take a test →
          </button>
        </div>
      `;
      body.dataset.rendered = '1';
    }

    function toggleCall(ci: number) {
      const body = document.querySelector<HTMLElement>(`[data-call-body="${ci}"]`);
      const chev = document.querySelector<HTMLElement>(`[data-call-toggle="${ci}"] .call-chev`);
      if (!body) return;
      const isHidden = body.classList.contains('hidden');
      if (isHidden) {
        renderCallBody(ci);
        body.classList.remove('hidden');
        if (chev) chev.style.transform = 'rotate(90deg)';
      } else {
        body.classList.add('hidden');
        if (chev) chev.style.transform = '';
      }
    }

    function toggleBankSection() {
      const body = document.getElementById('bank-body')!;
      const chev = document.getElementById('bank-chev')!;
      const isHidden = body.classList.contains('hidden');
      if (isHidden) {
        if (!bankRendered) renderBankBody();
        body.classList.remove('hidden');
        chev.style.transform = 'rotate(90deg)';
      } else {
        body.classList.add('hidden');
        chev.style.transform = '';
      }
    }

    document.getElementById('bank-toggle')!.addEventListener('click', toggleBankSection);

    document.getElementById('bank-body')!.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const take = target.closest('[data-take-call]') as HTMLElement | null;
      if (take) {
        e.stopPropagation();
        takeCallQuiz(parseInt(take.getAttribute('data-take-call')!, 10));
        return;
      }
      const callToggle = target.closest('[data-call-toggle]') as HTMLElement | null;
      if (callToggle) {
        toggleCall(parseInt(callToggle.getAttribute('data-call-toggle')!, 10));
      }
    });

    // ---------- Newsletter Quiz ----------
    type NewsletterQuestion = {
      type: 'mcq';
      question: string;
      options: string[];
      correct: number;
      explanation: string;
    };

    let newsCount = 1;
    let newsQuestions: NewsletterQuestion[] = [];

    function setNewsCount(n: number) {
      newsCount = n;
      document.querySelectorAll<HTMLButtonElement>('.news-count-btn').forEach(btn => {
        const val = parseInt(btn.getAttribute('data-news-count')!, 10);
        if (val === n) {
          btn.classList.add('bg-accent', 'text-white');
          btn.classList.remove('text-ink-secondary');
        } else {
          btn.classList.remove('bg-accent', 'text-white');
          btn.classList.add('text-ink-secondary');
        }
      });
    }

    function questionToHtmlSnippet(q: NewsletterQuestion): string {
      const optsHtml = q.options
        .map((opt, oi) => `${String.fromCharCode(65 + oi)}) ${opt}`)
        .join('<br>');
      return `<div style="margin: 24px 0;">\n  <p><strong>Q:</strong> ${q.question}</p>\n  <p>${optsHtml}</p>\n  <p><strong>Answer:</strong> ${String.fromCharCode(65 + q.correct)}) ${q.options[q.correct]}</p>\n  <p><em>Why:</em> ${q.explanation}</p>\n</div>`;
    }

    function flashCopied(btn: HTMLElement, label: string) {
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = label; }, 1500);
    }

    async function copyText(text: string, btn: HTMLElement, label: string) {
      try {
        await navigator.clipboard.writeText(text);
        flashCopied(btn, label);
      } catch {
        btn.textContent = 'Copy failed';
        setTimeout(() => { btn.textContent = label; }, 1500);
      }
    }

    function renderNewsletterOutput() {
      const out = document.getElementById('news-output')!;
      const copyAllWrap = document.getElementById('news-copy-all-wrap')!;
      if (!newsQuestions.length) {
        out.innerHTML = '';
        copyAllWrap.classList.add('hidden');
        return;
      }
      out.innerHTML = newsQuestions.map((q, qi) => {
        const opts = q.options.map((opt, oi) => `
          <div class="px-3 py-2 border rounded font-mono text-sm ${oi === q.correct ? 'border-signal-success text-signal-success' : 'border-rule-subtle text-ink-secondary'}">${String.fromCharCode(65 + oi)}) ${esc(opt)}</div>
        `).join('');
        return `
          <div class="bg-surface-1 border border-rule-subtle rounded p-6">
            <p class="text-sm text-ink-primary font-semibold leading-relaxed mb-4">${esc(q.question)}</p>
            <div class="space-y-2 mb-4">${opts}</div>
            <p class="text-sm text-ink-secondary leading-relaxed mb-4 pt-3 border-t border-rule-subtle"><span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Why · </span>${esc(q.explanation)}</p>
            <button type="button" data-news-copy="${qi}" class="px-4 py-2 font-mono text-[11px] uppercase tracking-label border border-rule-strong text-ink-secondary rounded hover:bg-surface-2 transition-colors">Copy HTML →</button>
          </div>
        `;
      }).join('');
      copyAllWrap.classList.remove('hidden');
    }

    async function generateNewsletter() {
      const btn = document.getElementById('news-generate-btn') as HTMLButtonElement;
      const status = document.getElementById('news-status') as HTMLElement;
      btn.disabled = true;
      status.classList.remove('hidden');
      status.textContent = '// generating…';

      try {
        const res = await fetch('/api/quiz/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ count: newsCount }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        newsQuestions = Array.isArray(data.questions) ? data.questions : [];
        renderNewsletterOutput();
        status.classList.add('hidden');
      } catch {
        status.textContent = '// generation failed — is the backend running?';
      } finally {
        btn.disabled = false;
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.news-count-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        setNewsCount(parseInt(btn.getAttribute('data-news-count')!, 10));
      });
    });

    document.getElementById('news-generate-btn')!.addEventListener('click', generateNewsletter);

    document.getElementById('news-output')!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest('[data-news-copy]') as HTMLElement | null;
      if (!btn) return;
      const qi = parseInt(btn.getAttribute('data-news-copy')!, 10);
      const q = newsQuestions[qi];
      if (!q) return;
      copyText(questionToHtmlSnippet(q), btn, 'Copy HTML →');
    });

    document.getElementById('news-copy-all-btn')!.addEventListener('click', e => {
      if (!newsQuestions.length) return;
      const all = newsQuestions.map(q => questionToHtmlSnippet(q)).join('\n\n');
      copyText(all, e.currentTarget as HTMLElement, 'Copy all HTML →');
    });

    setNewsCount(1);

    function isAnswerCorrect(a: QuizAnswer): boolean {
      return a.kind === 'mcq' ? a.correct : a.gotIt;
    }

    function renderQuestion() {
      if (!state) return;
      const { questions, current, answers } = state;
      const q = questions[current];
      const total = questions.length;

      (document.getElementById('progress-label') as HTMLElement).textContent =
        `Question ${current + 1} / ${total}`;
      (document.getElementById('progress-bar') as HTMLElement).style.width =
        `${(current / total) * 100}%`;

      const answered = answers.filter(a => a !== null).length;
      const correctSoFar = answers.filter(a => a !== null && isAnswerCorrect(a as QuizAnswer)).length;
      const runEl = document.getElementById('score-running') as HTMLElement;
      runEl.textContent = answered > 0 ? `${correctSoFar} / ${answered} correct` : '';

      (document.getElementById('question-text') as HTMLElement).textContent = q.question;
      (document.getElementById('feedback-block') as HTMLElement).classList.add('hidden');
      (document.getElementById('next-btn') as HTMLElement).classList.add('hidden');

      const optionsList = document.getElementById('options-list') as HTMLElement;

      if (q.type === 'mcq') {
        optionsList.innerHTML = q.options
          .map((opt, oi) => `
            <button
              type="button"
              data-oi="${oi}"
              class="quiz-option w-full text-left px-4 py-3 border border-rule-subtle rounded font-mono text-sm text-ink-secondary hover:border-accent hover:text-ink-primary transition-colors"
            >${String.fromCharCode(65 + oi)}) ${esc(opt)}</button>
          `)
          .join('');
      } else {
        optionsList.innerHTML = `
          <textarea
            data-flash-typed
            placeholder="write your answer…"
            rows="4"
            class="w-full bg-transparent border border-rule-subtle rounded p-3 font-mono text-sm text-ink-primary focus:outline-none focus:border-accent placeholder-ink-muted mb-3"
          ></textarea>
          <button
            type="button"
            data-flash-show
            class="w-full text-left px-4 py-3 border border-rule-subtle rounded font-mono text-sm text-ink-secondary hover:border-accent hover:text-ink-primary transition-colors"
          >Show answer →</button>
          <div data-flash-answer class="hidden mt-3 px-4 py-3 border border-rule-subtle rounded bg-surface-2">
            <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-1">Correct answer</p>
            <p class="text-sm text-ink-primary leading-relaxed">${esc(q.answer)}</p>
          </div>
          <div data-flash-rate class="hidden mt-3 grid grid-cols-2 gap-3">
            <button type="button" data-flash-rate-btn="missed" class="px-4 py-3 border border-rule-subtle rounded font-mono text-sm text-ink-secondary hover:border-signal-danger hover:text-signal-danger transition-colors">
              ✗ Missed it
            </button>
            <button type="button" data-flash-rate-btn="got" class="px-4 py-3 border border-rule-subtle rounded font-mono text-sm text-ink-secondary hover:border-signal-success hover:text-signal-success transition-colors">
              ✓ Got it
            </button>
          </div>
        `;
      }
    }

    function handleOptionClick(oi: number) {
      if (!state) return;
      const q = state.questions[state.current];
      if (q.type !== 'mcq') return;
      const isRight = oi === q.correct;
      state.answers[state.current] = { kind: 'mcq', chosen: oi, correct: isRight };

      const buttons = document.querySelectorAll<HTMLButtonElement>('.quiz-option');
      buttons.forEach((btn, i) => {
        btn.disabled = true;
        btn.classList.remove('hover:border-accent', 'hover:text-ink-primary');
        if (i === q.correct) {
          btn.classList.add('border-signal-success', 'text-signal-success');
        } else if (i === oi) {
          btn.classList.add('border-signal-danger', 'text-signal-danger');
        }
      });

      const feedbackBlock = document.getElementById('feedback-block') as HTMLElement;
      const verdict = document.getElementById('feedback-verdict') as HTMLElement;
      const explanation = document.getElementById('feedback-explanation') as HTMLElement;
      feedbackBlock.classList.remove('hidden');
      verdict.textContent = isRight ? '✓ Correct' : '✗ Incorrect';
      verdict.className = `font-mono text-xs uppercase tracking-label mb-2 ${isRight ? 'text-signal-success' : 'text-signal-danger'}`;
      explanation.textContent = q.explanation;

      const nextBtn = document.getElementById('next-btn') as HTMLElement;
      nextBtn.classList.remove('hidden');
      nextBtn.textContent = state.current === state.questions.length - 1 ? 'See results →' : 'Next →';
    }

    function handleFlashShow() {
      const answerEl = document.querySelector<HTMLElement>('[data-flash-answer]');
      const rateEl = document.querySelector<HTMLElement>('[data-flash-rate]');
      const showBtn = document.querySelector<HTMLButtonElement>('[data-flash-show]');
      const ta = document.querySelector<HTMLTextAreaElement>('[data-flash-typed]');
      if (!answerEl || !rateEl || !showBtn) return;
      if (ta) ta.readOnly = true;
      answerEl.classList.remove('hidden');
      rateEl.classList.remove('hidden');
      showBtn.disabled = true;
      showBtn.classList.add('hidden');
    }

    function handleFlashRate(gotIt: boolean) {
      if (!state) return;
      const ta = document.querySelector<HTMLTextAreaElement>('[data-flash-typed]');
      const typed = ta ? ta.value.trim() : '';
      state.answers[state.current] = { kind: 'flashcard', gotIt, typed };

      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-flash-rate-btn]');
      buttons.forEach(btn => {
        btn.disabled = true;
        btn.classList.remove('hover:border-signal-success', 'hover:text-signal-success', 'hover:border-signal-danger', 'hover:text-signal-danger');
        const isPick = btn.getAttribute('data-flash-rate-btn') === (gotIt ? 'got' : 'missed');
        if (isPick) {
          if (gotIt) btn.classList.add('border-signal-success', 'text-signal-success');
          else btn.classList.add('border-signal-danger', 'text-signal-danger');
        }
      });

      const feedbackBlock = document.getElementById('feedback-block') as HTMLElement;
      const verdict = document.getElementById('feedback-verdict') as HTMLElement;
      const explanation = document.getElementById('feedback-explanation') as HTMLElement;
      feedbackBlock.classList.remove('hidden');
      verdict.textContent = gotIt ? '✓ Got it' : '✗ Missed it';
      verdict.className = `font-mono text-xs uppercase tracking-label mb-2 ${gotIt ? 'text-signal-success' : 'text-signal-danger'}`;
      explanation.textContent = '';

      const nextBtn = document.getElementById('next-btn') as HTMLElement;
      nextBtn.classList.remove('hidden');
      nextBtn.textContent = state.current === state.questions.length - 1 ? 'See results →' : 'Next →';
    }

    function showScoreScreen() {
      if (!state) return;
      document.getElementById('quiz-container')!.classList.add('hidden');
      document.getElementById('score-screen')!.classList.remove('hidden');

      const { questions, answers } = state;
      const total = questions.length;
      const correct = answers.filter(a => a !== null && isAnswerCorrect(a as QuizAnswer)).length;
      const pct = Math.round((correct / total) * 100);
      const pass = pct >= 70;

      (document.getElementById('progress-bar') as HTMLElement).style.width = '100%';
      (document.getElementById('progress-label') as HTMLElement).textContent =
        `Question ${total} / ${total}`;

      (document.getElementById('final-score') as HTMLElement).textContent =
        `${correct} / ${total} correct — ${pct}%`;
      const verdictEl = document.getElementById('final-verdict') as HTMLElement;
      verdictEl.textContent = pass ? '✓ Pass' : '✗ Did not pass';
      verdictEl.className = `font-mono text-sm uppercase tracking-label mt-2 ${pass ? 'text-signal-success' : 'text-signal-danger'}`;

      (document.getElementById('review-list') as HTMLElement).innerHTML = questions
        .map((q, i) => {
          const a = answers[i];
          const isRight = a !== null && isAnswerCorrect(a as QuizAnswer);
          const head = `
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[11px] pt-0.5 ${isRight ? 'text-signal-success' : 'text-signal-danger'}">${isRight ? '✓' : '✗'}</span>
              <p class="text-sm font-semibold text-ink-primary leading-relaxed">${esc(q.question)}</p>
            </div>
          `;
          if (q.type === 'mcq') {
            const mcqA = a as McqAnswer | null;
            const chosenLine = mcqA && !mcqA.correct
              ? `<p class="font-mono text-xs text-signal-danger ml-6 mb-1">Your answer: ${esc(q.options[mcqA.chosen])}</p>`
              : '';
            return `
              <div class="bg-surface-1 border border-rule-subtle rounded p-6">
                ${head}
                ${chosenLine}
                <p class="font-mono text-xs text-signal-success ml-6 mb-2">Correct: ${esc(q.options[q.correct])}</p>
                <p class="text-sm text-ink-muted ml-6 leading-relaxed">${esc(q.explanation)}</p>
              </div>
            `;
          }
          const flashA = a as FlashcardAnswer | null;
          const selfRated = flashA
            ? `<p class="font-mono text-xs ml-6 mb-2 ${flashA.gotIt ? 'text-signal-success' : 'text-signal-danger'}">${flashA.gotIt ? '✓ Got it' : '✗ Missed it'}</p>`
            : '';
          const typedLine = flashA && flashA.typed
            ? `<p class="text-sm text-ink-secondary ml-6 mb-2 leading-relaxed"><span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Your answer · </span>${esc(flashA.typed)}</p>`
            : '';
          return `
            <div class="bg-surface-1 border border-rule-subtle rounded p-6">
              ${head}
              ${selfRated}
              ${typedLine}
              <p class="text-sm text-ink-muted ml-6 leading-relaxed"><span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">Correct · </span>${esc(q.answer)}</p>
            </div>
          `;
        })
        .join('');
    }

    function scrollToQuiz() {
      document.getElementById('quiz-container')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function takeCallQuiz(callIndex: number) {
      const call = bankCalls[callIndex];
      if (!call || !call.questions.length) return;
      state = {
        questions: call.questions.slice(),
        current: 0,
        answers: new Array(call.questions.length).fill(null),
        source: { kind: 'call', callIndex },
      };
      document.getElementById('score-screen')!.classList.add('hidden');
      document.getElementById('quiz-container')!.classList.remove('hidden');
      renderQuestion();
      scrollToQuiz();
    }

    async function generateQuiz() {
      const btn = document.getElementById('generate-btn') as HTMLButtonElement;
      const status = document.getElementById('gen-status') as HTMLElement;
      const quizContainer = document.getElementById('quiz-container') as HTMLElement;
      const scoreScreen = document.getElementById('score-screen') as HTMLElement;

      btn.disabled = true;
      status.classList.remove('hidden');
      status.textContent = '// generating…';
      quizContainer.classList.add('hidden');
      scoreScreen.classList.add('hidden');

      try {
        const poolRes = await fetch('/api/quiz/pool');
        const pool = await poolRes.json();
        const callCount = pool.total_calls ?? 0;
        status.textContent = `// generating quiz from ${callCount} call${callCount !== 1 ? 's' : ''}…`;

        const res = await fetch('/api/quiz/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ count: 10 }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();

        state = {
          questions: data.questions,
          current: 0,
          answers: new Array(data.questions.length).fill(null),
          source: { kind: 'generated' },
        };

        status.classList.add('hidden');
        btn.disabled = false;
        quizContainer.classList.remove('hidden');
        renderQuestion();
        scrollToQuiz();
      } catch {
        status.textContent = '// generation failed — is the backend running?';
        btn.disabled = false;
      }
    }

    document.getElementById('generate-btn')!.addEventListener('click', generateQuiz);

    document.getElementById('options-list')!.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const opt = target.closest('[data-oi]') as HTMLElement | null;
      if (opt) {
        handleOptionClick(parseInt(opt.getAttribute('data-oi')!, 10));
        return;
      }
      if (target.closest('[data-flash-show]')) {
        handleFlashShow();
        return;
      }
      const rate = target.closest('[data-flash-rate-btn]') as HTMLElement | null;
      if (rate) {
        handleFlashRate(rate.getAttribute('data-flash-rate-btn') === 'got');
      }
    });

    document.getElementById('next-btn')!.addEventListener('click', () => {
      if (!state) return;
      if (state.current === state.questions.length - 1) {
        showScoreScreen();
      } else {
        state.current++;
        renderQuestion();
      }
    });

    document.getElementById('retake-btn')!.addEventListener('click', () => {
      if (state && state.source.kind === 'call') {
        takeCallQuiz(state.source.callIndex);
      } else {
        generateQuiz();
      }
    });

    loadPoolStats();
  </script>
</AgentLayout>
