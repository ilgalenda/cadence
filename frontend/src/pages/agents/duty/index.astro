---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { DUTY_AGENT_NAME, DUTY_AGENT_TAGLINE, DUTY_NAV } from '../../../agents/duty/config';
---
<AgentLayout title="Overview" agentName={DUTY_AGENT_NAME} agentTagline={DUTY_AGENT_TAGLINE} navItems={DUTY_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · Duty & Tax"
      heading="Duty & Tax."
      lead="Estimate the landed cost of a shipment — duty, VAT/GST, and total — so shipping decisions don't wait on customs. Describe a shipment in plain language and the agent classifies the HS code, looks up rates, and computes the breakdown."
    >
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <div class="grid grid-cols-4 border-y border-rule-strong mb-14">
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Quotes</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-total">—</p>
      </div>
      <div class="px-5 py-5 flex items-center">
        <a href="/agents/duty/quote" class="font-mono text-[11px] uppercase tracking-label text-accent hover:underline">New quote →</a>
      </div>
    </div>

    <section>
      <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
        <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Recent quotes</h2>
      </div>
      <ul id="recent">
        <li class="py-4 font-mono text-xs text-ink-muted">// loading…</li>
      </ul>
    </section>
  </div>

  <script>
    import { escHtml } from '../../../lib/owlChat';

    async function load() {
      try {
        const s = await (await fetch('/api/duty/stats')).json();
        document.getElementById('stat-total')!.textContent = String(s.quotes_total ?? 0).padStart(2, '0');
      } catch {}
      const el = document.getElementById('recent')!;
      try {
        const items = await (await fetch('/api/duty/quotes')).json();
        if (!items.length) { el.innerHTML = '<li class="py-4 font-mono text-xs text-ink-muted">// no quotes yet — start one</li>'; return; }
        el.innerHTML = items.slice(0, 8).map((q: any) => {
          const dest = escHtml(String(q.destination || (q.request ? q.request.slice(0, 60) : '—')));
          const landed = q.breakdown ? `${escHtml(String(q.breakdown.currency))} ${q.breakdown.landed_cost}` : '—';
          const mode = q.mode === 'assist' ? 'assist' : 'structured';
          const hs = q.hs_code ? ` · HS ${escHtml(String(q.hs_code))}` : '';
          return `<li class="border-b border-rule-subtle last:border-0 flex items-center justify-between py-3">
            <div class="min-w-0">
              <p class="text-sm text-ink-primary truncate">${dest}${hs}</p>
              <p class="font-mono text-[10px] uppercase tracking-label text-ink-muted mt-0.5">${mode} · ${escHtml(String(q.updated_at || ''))}</p>
            </div>
            <span class="font-mono text-sm tabular text-ink-primary shrink-0">${landed}</span>
          </li>`;
        }).join('');
      } catch {
        el.innerHTML = '<li class="py-4 font-mono text-xs text-signal-danger">// could not load quotes</li>';
      }
    }
    load();
  </script>
</AgentLayout>
