---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { DUTY_AGENT_NAME, DUTY_AGENT_TAGLINE, DUTY_NAV } from '../../../agents/duty/config';
---
<AgentLayout title="New quote" agentName={DUTY_AGENT_NAME} agentTagline={DUTY_AGENT_TAGLINE} navItems={DUTY_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader label="Workspace · Duty & Tax" heading="New quote." lead="Describe a shipment for an autonomous estimate, or enter the figures directly." />

    <!-- Mode toggle -->
    <div class="flex gap-1 mb-8 font-mono text-[11px] uppercase tracking-label">
      <button data-mode="assist" class="mode-btn px-3 py-1.5 border border-rule-strong text-ink-primary">Describe it</button>
      <button data-mode="structured" class="mode-btn px-3 py-1.5 border border-rule-subtle text-ink-muted">Structured</button>
    </div>

    <!-- Assist (natural language) -->
    <section id="panel-assist">
      <label class="block font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Shipment</label>
      <textarea id="assist-input" rows="3" class="w-full bg-transparent border border-rule-subtle rounded px-3 py-2 text-sm focus:outline-none focus:border-accent"
        placeholder="e.g. 200 PTP grandmaster units, total value $48,000, shipping from Ireland to Germany, $1,200 freight."></textarea>
      <div class="flex justify-end mt-3">
        <button id="assist-go" class="px-4 py-1.5 text-xs font-mono bg-accent text-white rounded hover:opacity-90">Estimate →</button>
      </div>
      <div id="assist-result" class="owl-prose mt-6 text-sm text-ink-secondary"></div>
    </section>

    <!-- Structured -->
    <section id="panel-structured" class="hidden">
      <div class="grid grid-cols-2 gap-4 max-w-2xl">
        <label class="block"><span class="fld-label">Destination (ISO-2)</span><input id="f-dest" placeholder="DE" class="fld" /></label>
        <label class="block"><span class="fld-label">HS code</span><input id="f-hs" placeholder="8517" class="fld" /></label>
        <label class="block"><span class="fld-label">Goods value</span><input id="f-goods" type="number" placeholder="48000" class="fld" /></label>
        <label class="block"><span class="fld-label">Currency</span><input id="f-cur" value="USD" class="fld" /></label>
        <label class="block"><span class="fld-label">Freight</span><input id="f-freight" type="number" placeholder="1200" class="fld" /></label>
        <label class="block"><span class="fld-label">Insurance</span><input id="f-ins" type="number" placeholder="0" class="fld" /></label>
        <label class="block"><span class="fld-label">Other fees</span><input id="f-other" type="number" placeholder="0" class="fld" /></label>
        <label class="block"><span class="fld-label">Goods description (optional)</span><input id="f-desc" placeholder="PTP grandmasters" class="fld" /></label>
      </div>
      <div class="flex justify-end mt-4 max-w-2xl">
        <button id="calc-go" class="px-4 py-1.5 text-xs font-mono bg-accent text-white rounded hover:opacity-90">Compute →</button>
      </div>
      <div id="calc-result" class="mt-6"></div>
    </section>
  </div>

  <style>
    .fld-label { display:block; font-family:ui-monospace,monospace; font-size:10px; text-transform:uppercase; letter-spacing:0.08em; color:var(--ink-muted,#888); margin-bottom:4px; }
    .fld { width:100%; background:transparent; border:1px solid var(--rule-subtle,#333); border-radius:4px; padding:6px 8px; font-size:14px; }
    .fld:focus { outline:none; border-color:var(--accent,#6366f1); }
  </style>

  <script>
    import { streamChat, renderMarkdown } from '../../../lib/owlChat';

    // Mode toggle
    const panels: Record<string, HTMLElement> = {
      assist: document.getElementById('panel-assist')!,
      structured: document.getElementById('panel-structured')!,
    };
    document.querySelectorAll<HTMLButtonElement>('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.dataset.mode!;
        Object.entries(panels).forEach(([k, el]) => el.classList.toggle('hidden', k !== mode));
        document.querySelectorAll<HTMLButtonElement>('.mode-btn').forEach(b => {
          const on = b.dataset.mode === mode;
          b.classList.toggle('border-rule-strong', on);
          b.classList.toggle('text-ink-primary', on);
          b.classList.toggle('border-rule-subtle', !on);
          b.classList.toggle('text-ink-muted', !on);
        });
      });
    });

    // Assist mode — stream the autonomous agent
    const assistGo = document.getElementById('assist-go') as HTMLButtonElement;
    const assistInput = document.getElementById('assist-input') as HTMLTextAreaElement;
    const assistResult = document.getElementById('assist-result')!;
    assistGo.addEventListener('click', async () => {
      const text = assistInput.value.trim();
      if (!text) return;
      assistGo.disabled = true;
      assistResult.innerHTML = '<p class="font-mono text-xs text-ink-muted animate-pulse">// estimating…</p>';
      await streamChat({
        url: '/api/duty/assist',
        messages: [{ role: 'user', content: text }],
        onText: (_d, full) => { assistResult.innerHTML = renderMarkdown(full); },
        onError: (m) => { assistResult.innerHTML = `<p class="font-mono text-xs text-signal-danger">// ${m}</p>`; },
      });
      assistGo.disabled = false;
    });

    // Structured mode — deterministic compute
    const calcGo = document.getElementById('calc-go') as HTMLButtonElement;
    const calcResult = document.getElementById('calc-result')!;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const num = (id: string) => parseFloat(val(id)) || 0;
    calcGo.addEventListener('click', async () => {
      if (!val('f-dest') || !val('f-hs')) { calcResult.innerHTML = '<p class="font-mono text-xs text-signal-danger">// destination and HS code are required</p>'; return; }
      calcGo.disabled = true;
      calcResult.innerHTML = '<p class="font-mono text-xs text-ink-muted animate-pulse">// computing…</p>';
      try {
        const res = await fetch('/api/duty/quote', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            destination: val('f-dest'), hs_code: val('f-hs'), goods_value: num('f-goods'),
            freight: num('f-freight'), insurance: num('f-ins'), other_fees: num('f-other'),
            currency: val('f-cur') || 'USD', goods_description: val('f-desc'),
          }),
        });
        if (!res.ok) throw new Error((await res.json()).detail || String(res.status));
        const d = await res.json();
        const b = d.breakdown, cur = b.currency;
        const row = (label: string, v: number, strong = false) =>
          `<tr class="border-b border-rule-subtle"><td class="py-2 ${strong ? 'text-ink-primary font-medium' : 'text-ink-secondary'}">${label}</td><td class="py-2 text-right font-mono tabular ${strong ? 'text-ink-primary font-medium' : 'text-ink-secondary'}">${cur} ${v}</td></tr>`;
        calcResult.innerHTML = `
          <div class="border border-rule-subtle rounded p-4 max-w-md bg-surface-1">
            <p class="font-mono text-[10px] uppercase tracking-label text-ink-muted mb-3">Landed cost · ${b.valuation_basis} basis · duty ${(d.rate.duty_rate*100).toFixed(1)}% · VAT ${(d.rate.vat_rate*100).toFixed(1)}%</p>
            <table class="w-full text-sm">
              ${row('Goods value', b.inputs.goods_value)}
              ${row('Freight', b.inputs.freight)}
              ${row('Insurance', b.inputs.insurance)}
              ${row('Duty', b.duty)}
              ${row('VAT / GST', b.vat)}
              ${row('Total taxes', b.total_taxes)}
              ${row('Landed cost', b.landed_cost, true)}
            </table>
            ${d.rate.notes ? `<p class="font-mono text-[10px] text-ink-muted mt-3">// ${d.rate.notes}</p>` : ''}
            <p class="font-mono text-[10px] text-ink-muted mt-1">// estimate from sample rate data — not customs advice</p>
          </div>`;
      } catch (e: any) {
        calcResult.innerHTML = `<p class="font-mono text-xs text-signal-danger">// ${e?.message || e}</p>`;
      }
      calcGo.disabled = false;
    });
  </script>
</AgentLayout>
