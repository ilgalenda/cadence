---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { FORECAST_AGENT_NAME, FORECAST_AGENT_TAGLINE, FORECAST_NAV } from '../../../agents/forecast/config';
---
<AgentLayout title="Overview" agentName={FORECAST_AGENT_NAME} agentTagline={FORECAST_AGENT_TAGLINE} navItems={FORECAST_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · Forecasting"
      heading="Forecasting."
      lead="Pipeline by vertical and stage, a probability-weighted revenue forecast, and pipeline-hygiene flags. Sync deals from your CRM connector to begin."
    >
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <div class="flex items-center gap-3 mb-8">
      <button id="sync" class="px-4 py-1.5 text-xs font-mono bg-accent text-white rounded hover:opacity-90">Sync from CRM →</button>
      <span id="sync-note" class="font-mono text-[11px] text-ink-muted"></span>
    </div>

    <div class="grid grid-cols-4 border-y border-rule-strong mb-12">
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Open deals</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-deals">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Open value</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-open">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Weighted forecast</p>
        <p class="font-mono text-2xl tabular text-accent" id="stat-fc">—</p>
      </div>
      <div class="px-5 py-5">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Hygiene flags</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-hyg">—</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Pipeline by vertical</h2>
        </div>
        <ul id="by-vertical"><li class="py-4 font-mono text-xs text-ink-muted">// sync to load</li></ul>
      </section>
      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Pipeline hygiene</h2>
        </div>
        <ul id="hygiene"><li class="py-4 font-mono text-xs text-ink-muted">// sync to load</li></ul>
      </section>
    </div>
  </div>

  <script>
    const money = (n: number) => {
      if (n >= 1000) return `${(n / 1000).toFixed(n >= 100000 ? 0 : 1)}k`;
      return String(n);
    };

    async function refresh() {
      try {
        const s = await (await fetch('/api/forecast/stats')).json();
        document.getElementById('stat-deals')!.textContent = String(s.deals_total ?? 0).padStart(2, '0');
        document.getElementById('stat-open')!.textContent = money(s.open_value ?? 0);
        document.getElementById('stat-fc')!.textContent = money(s.weighted_forecast ?? 0);
      } catch {}

      try {
        const p = await (await fetch('/api/forecast/pipeline')).json();
        const vEl = document.getElementById('by-vertical')!;
        const verts = Object.entries(p.by_vertical || {});
        vEl.innerHTML = verts.length ? verts.map(([k, v]: any) =>
          `<li class="flex items-center justify-between py-2.5 border-b border-rule-subtle last:border-0">
             <span class="text-sm text-ink-secondary">${k} <span class="font-mono text-[10px] text-ink-muted">· ${v.count}</span></span>
             <span class="font-mono text-sm tabular text-ink-primary">${money(v.amount)}</span>
           </li>`).join('') : '<li class="py-4 font-mono text-xs text-ink-muted">// no open deals</li>';
      } catch {}

      try {
        const h = await (await fetch('/api/forecast/hygiene')).json();
        document.getElementById('stat-hyg')!.textContent = String(h.count ?? 0).padStart(2, '0');
        const hEl = document.getElementById('hygiene')!;
        hEl.innerHTML = (h.issues || []).length ? h.issues.map((i: any) =>
          `<li class="py-2.5 border-b border-rule-subtle last:border-0">
             <p class="text-sm text-ink-primary truncate">${i.name}</p>
             <p class="font-mono text-[10px] uppercase tracking-label text-signal-warning mt-0.5">${i.issue}</p>
           </li>`).join('') : '<li class="py-4 font-mono text-xs text-signal-success">// pipeline is clean</li>';
      } catch {}
    }

    document.getElementById('sync')!.addEventListener('click', async () => {
      const note = document.getElementById('sync-note')!;
      note.textContent = '// syncing…';
      try {
        const r = await (await fetch('/api/forecast/sync', { method: 'POST' })).json();
        note.textContent = `// synced ${r.synced} deals`;
        await refresh();
      } catch {
        note.textContent = '// sync failed';
      }
    });

    refresh();
  </script>
</AgentLayout>
