---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { HI_AGENT_NAME, HI_AGENT_TAGLINE, HI_NAV, SIGNAL_TYPE_LABELS } from '../../../agents/high-intent/config';
---
<AgentLayout title="Signal queue" agentName={HI_AGENT_NAME} agentTagline={HI_AGENT_TAGLINE} navItems={HI_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · High-Intent · Queue"
      heading="Signal queue."
      lead="High-intent prospects detected and waiting for outreach composition. Sorted by signal strength."
    />

    <div class="flex items-center gap-3 mb-6">
      <select id="filter-type" class="bg-surface-1 border border-rule-subtle rounded px-3 py-1.5 text-xs font-mono">
        <option value="">All signal types</option>
        <option value="competitor_engagement">Competitor Engagement</option>
        <option value="influencer_engagement">Influencer Engagement</option>
        <option value="job_change">Recently Changed Roles</option>
        <option value="funding">Recently Funded</option>
        <option value="top_icp">Top 5% ICP Activity</option>
        <option value="company_engagement">Engaged with Timebeat</option>
      </select>
      <select id="filter-strength" class="bg-surface-1 border border-rule-subtle rounded px-3 py-1.5 text-xs font-mono">
        <option value="">All strengths</option>
        <option value="hot">Hot</option>
        <option value="warm">Warm</option>
        <option value="cold">Cold</option>
      </select>
      <span class="font-mono text-[11px] text-ink-muted" id="queue-count"></span>
    </div>

    <div id="queue-list">
      <p class="font-mono text-xs text-ink-muted py-8">// loading…</p>
    </div>

  </div>

  <script>
    const SIGNAL_TYPE_LABELS: Record<string, string> = {
      competitor_engagement: 'Competitor Engagement',
      influencer_engagement: 'Influencer Engagement',
      job_change: 'Recently Changed Roles',
      funding: 'Recently Funded',
      top_icp: 'Top 5% ICP Activity',
      company_engagement: 'Engaged with Timebeat',
    };

    let allSignals: any[] = [];

    const strengthColour: Record<string, string> = {
      hot: 'text-signal-danger',
      warm: 'text-signal-warning',
      cold: 'text-ink-muted',
    };

    async function load() {
      const res = await fetch('/api/high-intent/queue');
      allSignals = await res.json();
      render();
    }

    function render() {
      const typeFilter = (document.getElementById('filter-type') as HTMLSelectElement).value;
      const strengthFilter = (document.getElementById('filter-strength') as HTMLSelectElement).value;

      let signals = allSignals;
      if (typeFilter) signals = signals.filter(s => s.signal_type === typeFilter);
      if (strengthFilter) signals = signals.filter(s => s.signal_strength === strengthFilter);

      document.getElementById('queue-count')!.textContent = `${signals.length} signal${signals.length !== 1 ? 's' : ''}`;

      const el = document.getElementById('queue-list')!;
      if (!signals.length) {
        el.innerHTML = '<p class="font-mono text-xs text-ink-muted py-8">// no signals match the current filter</p>';
        return;
      }

      el.innerHTML = signals.map((s: any) => {
        const profile = s.profile || {};
        const strength = s.signal_strength || 'cold';
        const statusMap: Record<string, string> = {
          pending: 'pending',
          composing: 'composing…',
          composed: 'composed',
          approved: 'approved',
        };
        const status = statusMap[s.status] || s.status;
        return `
          <div class="border-b border-rule-subtle py-5 grid grid-cols-[1fr_auto] gap-6 items-start">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <span class="font-mono text-[10px] uppercase tracking-label ${strengthColour[strength] || 'text-ink-muted'}">${strength.toUpperCase()}</span>
                <span class="font-mono text-[10px] text-ink-muted">${SIGNAL_TYPE_LABELS[s.signal_type] || s.signal_type}</span>
                <span class="font-mono text-[10px] text-ink-muted">· ${profile.confidence || ''} confidence</span>
              </div>
              <p class="text-base font-semibold text-ink-primary">${profile.full_name || '—'}</p>
              <p class="text-sm text-ink-secondary">${profile.job_title || ''}${profile.company ? ` · ${profile.company}` : ''}</p>
              ${profile.linkedin_url ? `<a href="${profile.linkedin_url}" target="_blank" rel="noopener" class="font-mono text-[11px] text-accent hover:underline">LinkedIn →</a>` : ''}
              <p class="text-xs text-ink-secondary mt-2 leading-relaxed max-w-xl">${profile.signal_context || ''}</p>
              ${profile.timebeat_fit_reason ? `<p class="text-xs text-ink-muted mt-1 italic leading-relaxed max-w-xl">${profile.timebeat_fit_reason}</p>` : ''}
            </div>
            <div class="flex flex-col items-end gap-2 shrink-0">
              <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-surface-2 text-ink-muted">${status}</span>
              <a href="/agents/high-intent/compose?id=${s.id}" class="px-4 py-1.5 bg-accent text-ink-inverse text-xs rounded hover:opacity-90">Compose →</a>
              <button type="button" data-id="${s.id}" class="dismiss-btn font-mono text-[10px] text-ink-muted hover:text-signal-danger transition-colors">Dismiss</button>
            </div>
          </div>
        `;
      }).join('');

      document.querySelectorAll('.dismiss-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          await fetch(`/api/high-intent/signals/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: 'dismissed' }),
          });
          allSignals = allSignals.filter(s => s.id !== id);
          render();
        });
      });
    }

    document.getElementById('filter-type')!.addEventListener('change', render);
    document.getElementById('filter-strength')!.addEventListener('change', render);

    load().catch(() => {
      document.getElementById('queue-list')!.innerHTML = '<p class="font-mono text-xs text-signal-danger py-8">// could not load queue</p>';
    });
  </script>
</AgentLayout>
