---
import AgentLayout from '../../../../layouts/AgentLayout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { LEAD_AGENT_NAME, LEAD_AGENT_TAGLINE, LEAD_NAV } from '../../../../agents/lead/config';
---
<AgentLayout title="Campaigns" agentName={LEAD_AGENT_NAME} agentTagline={LEAD_AGENT_TAGLINE} navItems={LEAD_NAV}>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · Lead · Campaigns"
      heading="Campaigns."
      lead="Every analysed lead and generated sequence, kept here for reuse and follow-up."
    >
      <a slot="meta" href="/agents/lead/new" class="text-accent hover:underline">+ New campaign</a>
    </PageHeader>

    <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
      <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">All campaigns</h2>
      <span id="count" class="font-mono text-[11px] tabular text-ink-muted">—</span>
    </div>

    <ul id="campaigns-list">
      <li class="py-8 font-mono text-xs text-ink-muted">// loading…</li>
    </ul>
  </div>

  <script>
    const list = document.getElementById('campaigns-list')!;
    const count = document.getElementById('count')!;
    let campaigns: any[] = [];

    function esc(s: string) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function render(items: any[]) {
      count.textContent = items.length.toString().padStart(2, '0') + ' total';
      if (!items.length) {
        list.innerHTML = '<li class="py-8 font-mono text-xs text-ink-muted">// no campaigns yet — <a href="/agents/lead/new" class="text-accent">start one</a></li>';
        return;
      }
      list.innerHTML = items.map((c: any) => {
        const stage = c.email_sequence ? 'EMAIL · ' + c.email_sequence.length + ' touches'
                    : c.boolean_search ? 'LINKEDIN'
                    : c.signal_analysis ? 'ANALYSED'
                    : 'DRAFT';
        const synced = c.calendar_events ? ` · ${c.calendar_events.length} events synced` : '';
        const sa = c.signal_analysis || {};
        const hasScore = sa.lead_score !== undefined && sa.lead_score !== null;
        const grade = sa.lead_grade || 'C';
        const gradeColor = grade === 'A' ? 'text-accent border-accent' : grade === 'B' ? 'text-ink-primary border-rule-strong' : 'text-ink-muted border-rule-subtle';
        const scoreBadge = hasScore
          ? `<span class="font-mono text-[10px] uppercase tracking-label border px-2 py-0.5 ${gradeColor}" title="Behavioural lead score">${esc(String(sa.lead_score))} · ${esc(grade)}</span>`
          : '';
        return `<li>
          <div class="group relative grid grid-cols-[auto_1fr_auto_auto] gap-8 items-start py-6 border-b border-rule-subtle hover:bg-surface-1 transition-colors -mx-4 px-4">
            <a href="/agents/lead/new?id=${encodeURIComponent(c.id)}" class="absolute inset-0" aria-label="Open ${esc(c.title || 'Untitled')}"></a>
            <span class="font-mono text-[11px] tabular text-ink-muted pt-1">${esc(c.updated_at || c.created_at || '')}</span>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-base font-semibold tracking-tightest leading-tight group-hover:text-accent transition-colors truncate">${esc(c.title || 'Untitled')}</h3>
                ${scoreBadge}
              </div>
              <p class="text-xs text-ink-secondary mt-1">${esc(stage)}${esc(synced)}</p>
            </div>
            <button type="button" data-delete-id="${esc(c.id)}" class="relative z-10 font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-signal-danger pt-1 transition-colors">delete</button>
            <span class="font-mono text-sm text-ink-muted group-hover:text-accent pt-1">→</span>
          </div>
        </li>`;
      }).join('');
    }

    async function handleDelete(id: string) {
      if (!confirm('Delete this campaign? Recipients, sequences and calendar events tied to it will be removed.')) return;
      try {
        const res = await fetch('/api/lead/campaigns/' + encodeURIComponent(id), { method: 'DELETE' });
        if (!res.ok) throw new Error(String(res.status));
        campaigns = campaigns.filter(c => c.id !== id);
        render(campaigns);
      } catch {
        const banner = document.createElement('li');
        banner.className = 'py-3 font-mono text-xs text-signal-danger';
        banner.textContent = '// could not delete campaign';
        list.prepend(banner);
        setTimeout(() => banner.remove(), 4000);
      }
    }

    list.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const btn = target.closest('[data-delete-id]') as HTMLElement | null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      handleDelete(btn.getAttribute('data-delete-id')!);
    });

    (async () => {
      try {
        const res = await fetch('/api/lead/campaigns');
        campaigns = await res.json();
        render(campaigns);
      } catch {
        list.innerHTML = '<li class="py-8 font-mono text-xs text-signal-danger">// could not load campaigns</li>';
      }
    })();
  </script>
</AgentLayout>
