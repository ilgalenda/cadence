---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { LEAD_AGENT_NAME, LEAD_AGENT_TAGLINE, LEAD_NAV } from '../../../agents/lead/config';

const areas = [
  { index: '01', href: '/agents/lead/new',       title: 'New campaign',     description: 'Paste a lead, image, or CRM export — Owl runs signal analysis and proposes a campaign.' },
  { index: '02', href: '/agents/lead/campaigns', title: 'Saved campaigns',  description: 'Every campaign is saved. Pick one to add a new touch point or review what shipped.' },
  { index: '03', href: '/agents/lead/new#linkedin', title: 'LinkedIn search', description: 'Generate Sales Navigator boolean strings calibrated to Timebeat verticals.' },
  { index: '04', href: '/agents/calls',           title: 'From a call',     description: 'Hand off any analysed call into a personalised outreach sequence.' },
];
---
<AgentLayout
  title="Overview"
  agentName={LEAD_AGENT_NAME}
  agentTagline={LEAD_AGENT_TAGLINE}
  navItems={LEAD_NAV}
>
  <div class="px-10 py-12 max-w-5xl">

    <PageHeader
      label="Workspace · Lead"
      heading="Lead Agent."
      lead="Turn inbound leads into personalised outreach. Claude generates, Owl refines with the Timebeat knowledge base."
    >
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <div class="grid grid-cols-4 border-y border-rule-strong mb-14">
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Campaigns</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-campaigns">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Sequences</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-sequences">—</p>
      </div>
      <div class="px-5 py-5 border-r border-rule-subtle">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Calendar synced</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-synced">—</p>
      </div>
      <div class="px-5 py-5">
        <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">Leads analysed</p>
        <p class="font-mono text-2xl tabular text-ink-primary" id="stat-leads">—</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-14">

      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Start here</h2>
          <a href="/agents/lead/new" class="font-mono text-[11px] uppercase tracking-label text-accent hover:underline">New campaign →</a>
        </div>
        <ul>
          {areas.map(a => (
            <li>
              <a href={a.href} class="group grid grid-cols-[auto_1fr_auto] gap-8 items-start py-6 border-b border-rule-subtle hover:bg-surface-1 transition-colors duration-150 ease-decelerate -mx-4 px-4">
                <span class="font-mono text-xs tabular text-ink-muted pt-1">{a.index}</span>
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold tracking-tightest leading-tight group-hover:text-accent transition-colors duration-150 ease-decelerate">{a.title}</h3>
                  <p class="text-sm text-ink-secondary mt-1 leading-relaxed max-w-lg">{a.description}</p>
                </div>
                <span class="font-mono text-sm text-ink-muted group-hover:text-accent pt-1 transition-colors duration-150 ease-decelerate">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <div class="flex items-baseline justify-between pb-3 mb-2 border-b border-rule-strong">
          <h2 class="font-mono text-[11px] uppercase tracking-label text-ink-primary">Recent campaigns</h2>
          <a href="/agents/lead/campaigns" class="font-mono text-[11px] uppercase tracking-label text-ink-muted hover:text-accent transition-colors">View all →</a>
        </div>
        <ul id="recent-campaigns">
          <li class="py-6 font-mono text-xs text-ink-muted">// loading…</li>
        </ul>
      </section>

    </div>

  </div>

  <script>
    async function loadStats() {
      try {
        const res = await fetch('/api/lead/stats');
        const d = await res.json();
        const fmt = (n: number) => String(n ?? 0).padStart(2, '0');
        document.getElementById('stat-campaigns')!.textContent = fmt(d.campaigns_total);
        document.getElementById('stat-sequences')!.textContent = fmt(d.sequences_generated);
        document.getElementById('stat-synced')!.textContent = fmt(d.calendar_synced);
        document.getElementById('stat-leads')!.textContent = fmt(d.leads_analysed);
      } catch {}
    }

    async function loadRecent() {
      const el = document.getElementById('recent-campaigns')!;
      try {
        const res = await fetch('/api/lead/campaigns');
        const items = await res.json();
        if (!items.length) {
          el.innerHTML = '<li class="py-6 font-mono text-xs text-ink-muted">// no campaigns yet</li>';
          return;
        }
        el.innerHTML = items.slice(0, 6).map((c: any) => {
          const stage = c.email_sequence ? 'EMAIL' : c.boolean_search ? 'LINKEDIN' : 'DRAFT';
          return `<li class="border-b border-rule-subtle last:border-0">
            <a href="/agents/lead/new?id=${encodeURIComponent(c.id)}" class="block py-3 hover:text-accent transition-colors">
              <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-1">${c.updated_at || c.created_at || ''} · ${stage}</p>
              <p class="text-sm text-ink-primary truncate leading-snug">${c.title || 'Untitled'}</p>
            </a>
          </li>`;
        }).join('');
      } catch {
        el.innerHTML = '<li class="py-6 font-mono text-xs text-signal-danger">// could not load campaigns</li>';
      }
    }

    loadStats();
    loadRecent();
  </script>
</AgentLayout>
