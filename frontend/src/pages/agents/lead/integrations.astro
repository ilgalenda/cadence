---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { LEAD_AGENT_NAME, LEAD_AGENT_TAGLINE, LEAD_NAV } from '../../../agents/lead/config';
---
<AgentLayout
  title="Integrations"
  agentName={LEAD_AGENT_NAME}
  agentTagline={LEAD_AGENT_TAGLINE}
  navItems={LEAD_NAV}
>
  <div class="px-10 py-12 max-w-3xl">

    <PageHeader
      label="Workspace · Lead"
      heading="Integrations."
      lead="Connect external services so the Lead Agent can act on your behalf. Each user connects their own account — credentials stay isolated."
    />

    <section class="border-y border-rule-strong">
      <div class="grid grid-cols-[1fr_auto] gap-8 items-start py-6 px-1">
        <div class="min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">01 · Calendar</p>
          <h2 class="text-lg font-semibold tracking-tightest leading-tight">Google Calendar</h2>
          <p class="text-sm text-ink-secondary mt-1 leading-relaxed max-w-xl">
            Authorise the Lead Agent to create events on your primary Google Calendar so sequence touches can be scheduled in one click.
          </p>
          <p id="gcal-state" class="font-mono text-[11px] uppercase tracking-label text-ink-muted mt-3">// checking…</p>
        </div>
        <div id="gcal-ctrls" class="flex flex-col items-end gap-2 min-w-[12rem]"></div>
      </div>
    </section>

  </div>

  <script>
    const stateEl = document.getElementById('gcal-state')!;
    const ctrls = document.getElementById('gcal-ctrls')!;

    async function loadStatus() {
      stateEl.textContent = '// checking…';
      ctrls.innerHTML = '';
      try {
        const res = await fetch('/api/lead/google/status');
        const d = await res.json();
        if (!d.configured) {
          stateEl.textContent = '// not configured';
          ctrls.innerHTML = '<p class="text-sm text-ink-secondary text-right max-w-xs">Google OAuth credentials are not set on the backend. Ask the operator to configure <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code>.</p>';
          return;
        }
        if (d.available === false) {
          stateEl.textContent = '// not configured';
          ctrls.innerHTML = '<p class="text-sm text-ink-secondary text-right max-w-xs">Google Calendar sync isn’t configured on this deployment yet.</p>';
          return;
        }
        if (!d.connected) {
          stateEl.textContent = '// not connected';
          ctrls.innerHTML = '<a href="/api/lead/google/connect" class="inline-block px-4 py-2 bg-accent text-ink-inverse text-sm rounded">Connect Google Calendar</a>';
          return;
        }
        stateEl.textContent = `// connected as ${d.email}`;
        ctrls.innerHTML = '<button id="gcal-disconnect" class="px-3 py-1 text-xs border border-rule-subtle">Disconnect</button>';
        document.getElementById('gcal-disconnect')!.addEventListener('click', async () => {
          await fetch('/api/lead/google/disconnect', { method: 'POST' });
          loadStatus();
        });
      } catch (e: any) {
        stateEl.textContent = '// ' + (e?.message || 'failed to load');
      }
    }

    loadStatus();
  </script>
</AgentLayout>
