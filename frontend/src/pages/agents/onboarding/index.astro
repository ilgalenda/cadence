---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import StatusDot from '../../../components/StatusDot.astro';
import { ONBOARDING_AGENT_NAME, ONBOARDING_AGENT_TAGLINE, ONBOARDING_NAV } from '../../../agents/onboarding/config';
---
<AgentLayout title="Onboarding" agentName={ONBOARDING_AGENT_NAME} agentTagline={ONBOARDING_AGENT_TAGLINE} navItems={ONBOARDING_NAV}>
  <div class="px-10 py-12 max-w-3xl">

    <PageHeader label="Workspace · Onboarding" heading="Onboarding." lead="A guided walk-through of Cadence, grounded in your team's knowledge. Pick a track and ask anything.">
      <StatusDot slot="meta" variant="active" label="Status · Active" />
    </PageHeader>

    <!-- Track toggle -->
    <div class="flex gap-1 mb-6 font-mono text-[11px] uppercase tracking-label">
      <button data-role="sales" class="role-btn px-3 py-1.5 border border-rule-strong text-ink-primary">Sales / GTM</button>
      <button data-role="ops" class="role-btn px-3 py-1.5 border border-rule-subtle text-ink-muted">Operations</button>
    </div>

    <div id="thread" class="space-y-5 mb-6"></div>

    <div class="flex gap-2 items-end border-t border-rule-strong pt-4">
      <textarea id="input" rows="2" class="flex-1 bg-transparent border border-rule-subtle rounded px-3 py-2 text-sm focus:outline-none focus:border-accent"
        placeholder="e.g. I'm new to ops — where do I start?"></textarea>
      <button id="send" class="px-4 py-2 text-xs font-mono bg-accent text-white rounded hover:opacity-90">Send</button>
    </div>
  </div>

  <script>
    import { streamChat, renderMarkdown, escHtml } from '../../../lib/owlChat';
    type Msg = { role: 'user' | 'assistant'; content: string };

    let role = 'sales';
    const messages: Msg[] = [];
    const thread = document.getElementById('thread')!;
    const input = document.getElementById('input') as HTMLTextAreaElement;
    const sendBtn = document.getElementById('send') as HTMLButtonElement;

    document.querySelectorAll<HTMLButtonElement>('.role-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        role = btn.dataset.role!;
        document.querySelectorAll<HTMLButtonElement>('.role-btn').forEach(b => {
          const on = b.dataset.role === role;
          b.classList.toggle('border-rule-strong', on);
          b.classList.toggle('text-ink-primary', on);
          b.classList.toggle('border-rule-subtle', !on);
          b.classList.toggle('text-ink-muted', !on);
        });
      });
    });

    function bubble(role: 'user' | 'assistant'): HTMLElement {
      const wrap = document.createElement('div');
      wrap.innerHTML = `<p class="font-mono text-[10px] uppercase tracking-label text-ink-muted mb-1">${role === 'user' ? 'You' : 'Guide'}</p><div class="owl-prose text-sm ${role === 'user' ? 'text-ink-primary' : 'text-ink-secondary'}"></div>`;
      thread.appendChild(wrap);
      return wrap.querySelector('.owl-prose') as HTMLElement;
    }

    async function send() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      sendBtn.disabled = true;
      messages.push({ role: 'user', content: text });
      bubble('user').textContent = text;
      const out = bubble('assistant');
      out.innerHTML = '<span class="font-mono text-xs text-ink-muted animate-pulse">…</span>';
      const full = await streamChat({
        url: `/api/onboarding/stream?role=${encodeURIComponent(role)}`,
        messages,
        onText: (_d, f) => { out.innerHTML = renderMarkdown(f); },
        onError: (m) => { out.innerHTML = `<p class="font-mono text-xs text-signal-danger">// ${escHtml(m)}</p>`; },
      });
      if (full.trim()) messages.push({ role: 'assistant', content: full });
      sendBtn.disabled = false;
      input.focus();
    }

    sendBtn.addEventListener('click', send);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
    });
  </script>
</AgentLayout>
