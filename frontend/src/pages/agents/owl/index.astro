---
import AgentLayout from '../../../layouts/AgentLayout.astro';
import '../../../styles/owl.css';
import { OWL_AGENT_NAME, OWL_AGENT_TAGLINE, OWL_NAV, OWL_SUGGESTIONS } from '../../../agents/owl/config';
---

<AgentLayout
  title="Owl — Chat"
  agentName={OWL_AGENT_NAME}
  agentTagline={OWL_AGENT_TAGLINE}
  navItems={OWL_NAV}
  hideOwlDrawer={true}
>
  <div class="flex h-full">
    <!-- History rail (collapsible) -->
    <aside id="rail" class="w-72 shrink-0 border-r border-rule-subtle flex flex-col bg-surface-1 transition-[width,opacity] duration-200 ease-decelerate overflow-hidden">
      <div class="p-3 border-b border-rule-subtle space-y-3">
        <button id="new-chat" type="button"
          class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-md bg-surface-ink text-ink-inverse text-sm font-medium hover:opacity-90 transition-opacity duration-150 ease-decelerate">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none"><path d="M6.5 1v11M1 6.5h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          New conversation
        </button>
        <div class="flex items-center gap-2 bg-surface-0 border border-rule-subtle rounded-md px-2.5 py-1.5 focus-within:border-accent transition-colors duration-150">
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none" class="text-ink-muted shrink-0"><circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 8.5L11.5 11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          <input id="history-search" type="text" placeholder="Search conversations…" autocomplete="off"
            class="flex-1 bg-transparent text-xs focus:outline-none placeholder:text-ink-muted" />
        </div>
      </div>
      <div id="history-list" class="flex-1 overflow-y-auto px-2 py-2 space-y-0.5">
        <p class="font-mono text-[11px] text-ink-muted px-2 py-4">// loading…</p>
      </div>
    </aside>

    <!-- Reading column -->
    <section class="flex-1 flex flex-col min-w-0">
      <!-- Slim header -->
      <header class="flex items-center gap-3 h-12 px-4 border-b border-rule-subtle shrink-0">
        <button id="rail-toggle" type="button" aria-label="Toggle history" title="Toggle history"
          class="w-7 h-7 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-2 transition-colors duration-150">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><rect x="1.5" y="2.5" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/><path d="M5.5 2.5v10" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
        <p id="conv-title" class="text-sm font-medium tracking-tighter text-ink-primary truncate">New conversation</p>
      </header>

      <div id="thread" class="flex-1 overflow-y-auto">
        <div id="reading" class="owl-thread owl-reading max-w-[680px] mx-auto px-8 py-10 space-y-8">
          <!-- Empty state -->
          <div id="empty-state" class="flex flex-col items-center text-center pt-16 pb-8 gap-7">
            <div class="w-14 h-14 rounded-full bg-surface-1 border border-rule-subtle flex items-center justify-center overflow-hidden">
              <img src="/images/owl.png" alt="Owl" class="w-9 h-9 object-contain" onerror="this.parentElement.innerHTML='🦉'" />
            </div>
            <div class="space-y-2 max-w-sm">
              <p class="text-xl tracking-tightest text-ink-primary">Ask Owl anything</p>
              <p class="text-sm text-ink-secondary leading-relaxed">Your Timebeat knowledge partner — products, protocols, and your next sales conversation.</p>
            </div>
            <div class="w-full max-w-sm pt-1" id="suggestions">
              <p class="label text-ink-muted mb-2 text-left">Try asking</p>
              <div class="flex flex-col">
                {OWL_SUGGESTIONS.map((s) => (
                  <button data-suggestion={s} class="chip group flex items-center gap-2.5 w-full text-left py-2.5 border-b border-rule-subtle/60 text-sm text-ink-secondary hover:text-ink-primary transition-colors duration-150">
                    <span class="font-mono text-accent/40 group-hover:text-accent transition-colors duration-150">→</span>
                    <span>{s}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Composer (aligned to the reading column) -->
      <div class="px-8 pb-5 pt-1 shrink-0">
        <form id="composer" class="max-w-[680px] mx-auto">
          <div class="flex items-end gap-2 bg-surface-1 border border-rule-subtle rounded-xl pl-4 pr-2 py-2 shadow-lift focus-within:border-accent transition-colors duration-150">
            <textarea id="composer-input" rows="1" placeholder="Ask Owl anything…" autocomplete="off"
              class="flex-1 bg-transparent text-sm focus:outline-none placeholder:text-ink-muted resize-none max-h-40 leading-relaxed py-1"></textarea>
            <button id="send-btn" type="submit" aria-label="Send"
              class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity duration-150">
              <svg width="13" height="13" viewBox="0 0 12 12" fill="none"><path d="M1 6h10M6 1l5 5-5 5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button id="stop-btn" type="button" aria-label="Stop" class="hidden w-8 h-8 rounded-lg bg-surface-ink flex items-center justify-center shrink-0 hover:opacity-90 transition-opacity duration-150">
              <span class="w-3 h-3 rounded-[2px] bg-ink-inverse"></span>
            </button>
          </div>
          <p class="text-[10px] font-mono text-ink-muted mt-2 text-center">Enter to send · Shift+Enter for a new line</p>
        </form>
      </div>
    </section>
  </div>
</AgentLayout>

<script>
  import {
    renderMarkdown, streamChat, listConversations, getConversation,
    renameConversation, deleteConversation, getActiveConversationId,
    setActiveConversationId, relativeTime, buildCorrectionCard,
    type ChatMessage, type ConversationSummary,
  } from '../../../lib/owlChat';

  const reading      = document.getElementById('reading')!;
  const thread       = document.getElementById('thread')!;
  const form         = document.getElementById('composer') as HTMLFormElement;
  const input        = document.getElementById('composer-input') as HTMLTextAreaElement;
  const sendBtn      = document.getElementById('send-btn')!;
  const stopBtn      = document.getElementById('stop-btn')!;
  const newChatBtn   = document.getElementById('new-chat')!;
  const historyList  = document.getElementById('history-list')!;
  const searchInput  = document.getElementById('history-search') as HTMLInputElement;
  const rail         = document.getElementById('rail')!;
  const railToggle   = document.getElementById('rail-toggle')!;
  const convTitle    = document.getElementById('conv-title')!;

  let conversationId: string | null = null;
  let callId: string | null = null;  // when set, Owl is grounded in this analysed call
  let isStreaming = false;
  let abortController: AbortController | null = null;
  const messages: ChatMessage[] = [];

  // ─── DOM helpers ────────────────────────────────────────────────────────────

  const EMPTY_HTML = `
    <div id="empty-state" class="flex flex-col items-center text-center pt-16 pb-8 gap-7">
      <div class="w-14 h-14 rounded-full bg-surface-1 border border-rule-subtle flex items-center justify-center overflow-hidden">
        <img src="/images/owl.png" alt="Owl" class="w-9 h-9 object-contain" onerror="this.parentElement.innerHTML='🦉'" />
      </div>
      <div class="space-y-2 max-w-sm">
        <p class="text-xl tracking-tightest text-ink-primary">Ask Owl anything</p>
        <p class="text-sm text-ink-secondary leading-relaxed">Your Timebeat knowledge partner — products, protocols, and your next sales conversation.</p>
      </div>
    </div>`;

  function clearEmptyState() {
    document.getElementById('empty-state')?.remove();
  }
  function markTurns() {
    reading.classList.toggle('has-turns', reading.querySelector('.owl-turn') !== null);
  }
  function scrollToBottom() { thread.scrollTop = thread.scrollHeight; }

  // The user's question — a quiet mono lead + the question set as a section head.
  function appendUser(text: string) {
    clearEmptyState();
    const turn = document.createElement('div');
    turn.className = 'owl-turn owl-turn--you';
    const label = document.createElement('p');
    label.className = 'owl-lead-label';
    label.textContent = `// you · ${nowLabel()}`;
    const q = document.createElement('p');
    q.className = 'owl-lead';
    q.textContent = text;
    turn.append(label, q);
    reading.appendChild(turn);
    markTurns();
    scrollToBottom();
  }

  // One Owl answer: a byline rule, then a breathing dot that gives way to
  // streamed text, which finally settles into typeset prose.
  function createOwlTurn(model: string | null) {
    clearEmptyState();
    const turn = document.createElement('div');
    turn.className = 'owl-turn owl-turn--owl';

    const byline = document.createElement('div');
    byline.className = 'owl-byline';
    const dot = document.createElement('span');
    dot.className = 'owl-byline__dot ' + dotClass(model);
    const tag = document.createElement('span');
    tag.className = 'owl-byline__tag';
    tag.textContent = 'Owl';
    const rule = document.createElement('span');
    rule.className = 'owl-byline__rule';
    byline.append(dot, tag, rule);

    const body = document.createElement('div');
    const think = document.createElement('span');
    think.className = 'owl-think animate-signal-pulse inline-block';
    body.appendChild(think);

    turn.append(byline, body);
    reading.appendChild(turn);
    markTurns();
    scrollToBottom();

    let streamEl: HTMLElement | null = null;
    function ensureStream() {
      if (!streamEl) { body.innerHTML = ''; streamEl = document.createElement('div'); streamEl.className = 'owl-streaming'; body.appendChild(streamEl); }
    }
    return {
      turn,
      setModel(m: string) { dot.className = 'owl-byline__dot ' + dotClass(m); },
      setText(full: string) { ensureStream(); streamEl!.textContent = full; },
      finalise(full: string) {
        const rendered = renderMarkdown(full);
        if (!rendered.trim()) { turn.remove(); markTurns(); return; }
        const content = document.createElement('div');
        content.className = 'owl-content';
        content.innerHTML = rendered;
        body.innerHTML = '';
        body.appendChild(content);
        scrollToBottom();
      },
    };
  }

  function dotClass(model: string | null): string {
    if (!model) return 'owl-byline__dot--haiku';
    return model.includes('haiku') ? 'owl-byline__dot--haiku' : 'owl-byline__dot--sonnet';
  }
  function nowLabel(): string {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }

  // ─── Streaming state ──────────────────────────────────────────────────────────

  function setStreaming(active: boolean) {
    isStreaming = active;
    input.disabled = active;
    sendBtn.classList.toggle('hidden', active);
    stopBtn.classList.toggle('hidden', !active);
  }

  async function send(text: string) {
    if (isStreaming || !text.trim()) return;
    const isFirstTurn = conversationId === null;
    if (isFirstTurn) convTitle.textContent = text.slice(0, 80);

    appendUser(text);
    messages.push({ role: 'user', content: text });

    setStreaming(true);
    abortController = new AbortController();
    const owl = createOwlTurn(null);
    let gotText = false;

    await streamChat({
      messages,
      conversationId,
      callId,
      signal: abortController.signal,
      onConvId: (id) => { conversationId = id; setActiveConversationId(id); },
      onModel: (m) => owl.setModel(m),
      onText: (_delta, full) => { gotText = true; owl.setText(full); scrollToBottom(); },
      onCorrection: (c) => reading.appendChild(buildCorrectionCard(c)),
      onError: (msg) => { gotText = true; owl.setText(msg); },
      onDone: (full) => {
        if (full) { owl.finalise(full); messages.push({ role: 'assistant', content: full }); }
        else if (!gotText) { owl.turn.remove(); markTurns(); }
      },
    });

    setStreaming(false);
    abortController = null;
    refreshHistory(searchInput.value.trim() || undefined);
    if (isFirstTurn) input.focus();
  }

  function newChat() {
    if (isStreaming) { abortController?.abort(); setStreaming(false); }
    conversationId = null;
    setActiveConversationId(null);
    messages.length = 0;
    convTitle.textContent = 'New conversation';
    reading.classList.remove('has-turns');
    reading.innerHTML = EMPTY_HTML;
    input.focus();
    highlightActive();
  }

  async function loadConversation(id: string) {
    if (isStreaming) { abortController?.abort(); setStreaming(false); }
    reading.classList.remove('has-turns');
    reading.innerHTML = '<p class="font-mono text-[11px] text-ink-muted text-center py-8">// loading conversation…</p>';
    try {
      const session = await getConversation(id);
      conversationId = id;
      setActiveConversationId(id);
      convTitle.textContent = session.title || 'Conversation';
      messages.length = 0;
      reading.innerHTML = '';
      (session.messages || []).forEach((m: ChatMessage) => {
        if (m.role === 'user') appendUser(m.content);
        else if (m.role === 'assistant') createOwlTurn(session.model_used).finalise(m.content);
        messages.push({ role: m.role, content: m.content });
      });
      markTurns();
      scrollToBottom();
      highlightActive();
      input.focus();
    } catch {
      reading.innerHTML = '<p class="font-mono text-[11px] text-ink-muted text-center py-8">// Could not load this conversation.</p>';
    }
  }

  // ─── History rail ──────────────────────────────────────────────────────────

  function highlightActive() {
    historyList.querySelectorAll<HTMLElement>('[data-conv-id]').forEach(el => {
      el.classList.toggle('is-active', el.dataset.convId === conversationId);
    });
  }

  function renderHistoryRow(s: ConversationSummary): HTMLElement {
    const row = document.createElement('div');
    row.dataset.convId = s.id;
    row.className = 'owl-histrow group rounded-md pl-3 pr-2 py-2.5 hover:bg-surface-2 transition-colors duration-150 cursor-pointer';
    const modelDot = s.model_used === 'sonnet'
      ? '<span class="inline-block w-1.5 h-1.5 rounded-full bg-accent align-middle mr-1"></span>'
      : '<span class="inline-block w-1.5 h-1.5 rounded-full bg-ink-muted/60 align-middle mr-1"></span>';
    row.innerHTML = `
      <p class="text-sm text-ink-primary truncate leading-snug pr-10" data-title>${s.title || 'Chat'}</p>
      <p class="font-mono text-[10px] text-ink-muted mt-0.5">${modelDot}${s.model_used || 'owl'} · ${relativeTime((s as any).ts || s.timestamp || '')}</p>
      <div class="absolute top-2 right-1.5 hidden group-hover:flex items-center gap-0.5">
        <button data-act="rename" title="Rename" class="w-6 h-6 flex items-center justify-center rounded text-ink-muted hover:text-ink-primary hover:bg-surface-1">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M8.5 1.5l2 2L4 10l-2.5.5L2 8z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
        </button>
        <button data-act="delete" title="Delete" class="w-6 h-6 flex items-center justify-center rounded text-ink-muted hover:text-signal-danger hover:bg-surface-1">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 3.5h7M5 5.5v3M7 5.5v3M3.5 3.5l.5 6h4l.5-6M4.5 3.5V2h3v1.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>`;

    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-act]')) return;
      loadConversation(s.id);
    });
    row.querySelector('[data-act="rename"]')!.addEventListener('click', async () => {
      const current = (row.querySelector('[data-title]') as HTMLElement).textContent || '';
      const next = prompt('Rename conversation', current);
      if (next === null || !next.trim() || next.trim() === current) return;
      try {
        await renameConversation(s.id, next.trim());
        (row.querySelector('[data-title]') as HTMLElement).textContent = next.trim();
        if (conversationId === s.id) convTitle.textContent = next.trim();
      } catch { /* non-fatal */ }
    });
    row.querySelector('[data-act="delete"]')!.addEventListener('click', async () => {
      if (!confirm('Delete this conversation?')) return;
      try {
        await deleteConversation(s.id);
        row.remove();
        if (conversationId === s.id) newChat();
      } catch { /* non-fatal */ }
    });
    return row;
  }

  async function refreshHistory(query?: string) {
    try {
      const sessions = await listConversations(query);
      if (sessions.length === 0) {
        historyList.innerHTML = `<p class="font-mono text-[11px] text-ink-muted px-2 py-4">${query ? '// No matches.' : '// No conversations yet.'}</p>`;
        return;
      }
      historyList.innerHTML = '';
      sessions.forEach(s => historyList.appendChild(renderHistoryRow(s)));
      highlightActive();
    } catch {
      historyList.innerHTML = '<p class="font-mono text-[11px] text-ink-muted px-2 py-4">// Could not load history.</p>';
    }
  }

  // ─── Events ───────────────────────────────────────────────────────────────────

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value;
    input.value = '';
    input.style.height = 'auto';
    send(text);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 160) + 'px';
  });

  stopBtn.addEventListener('click', () => { abortController?.abort(); });
  newChatBtn.addEventListener('click', newChat);

  railToggle.addEventListener('click', () => {
    const collapsed = rail.classList.toggle('!w-0');
    rail.classList.toggle('opacity-0', collapsed);
  });

  document.querySelectorAll<HTMLButtonElement>('.chip').forEach(chip => {
    chip.addEventListener('click', () => send(chip.dataset.suggestion || ''));
  });

  let searchTimer: number | undefined;
  searchInput.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => refreshHistory(searchInput.value.trim() || undefined), 250);
  });

  // ─── Init: restore active conversation (deep-link ?c= wins) ────────────────────

  (async () => {
    await refreshHistory();
    const params = new URLSearchParams(window.location.search);
    callId = params.get('call_id');
    const q = params.get('q');
    if (callId) {
      // Grounded session: start fresh against the call. Auto-send a prefilled
      // question if one was passed (e.g. from "ask Owl" on the call page).
      if (q) { send(q); } else { input.focus(); }
    } else {
      const restore = params.get('c') || getActiveConversationId();
      if (restore) {
        try { await loadConversation(restore); }
        catch { setActiveConversationId(null); }
      } else {
        input.focus();
      }
    }
  })();
</script>
