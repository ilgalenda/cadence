---
/**
 * The release log.
 *
 * On the platform shell as of the uniformity pass — it was the last page besides
 * the retiring dashboard still using `DashboardLayout`.
 *
 * A quiet list on the reading measure: releases separated by hairlines, the
 * version and date in the readout voice, the prose in sans. The kind of change
 * is a **mark**, so "removed" and "security" read in the same vocabulary the
 * rest of the product uses for state.
 */
import PlatformLayout from '../layouts/PlatformLayout.astro';
import { CHANGELOG } from '../lib/version';

const entries = [...CHANGELOG].sort(
  (a, b) => b.version.localeCompare(a.version, undefined, { numeric: true }),
);

/**
 * Entries are written with `**emphasis**` and `` `identifiers` `` — the log is read as
 * prose and a module path needs to look like one. Rendered here rather than stored as
 * markup: the escape happens first, so an entry can never inject anything.
 */
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="change__strong">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="ds-mono">$1</code>');

/** Change kinds mapped onto the system's status marks rather than ad-hoc colours. */
const MARK: Record<string, string> = {
  Added: 'locked',
  Changed: 'live',
  Fixed: 'live',
  Security: 'drift',
  Removed: 'fault',
};
---
<PlatformLayout title="Changelog">
  <div class="ds-page log-page">
    <header class="ds-page__head ds-arrive">
      <p class="ds-eyebrow">Changelog</p>
      <h1 class="ds-heading ds-page__title">Release log</h1>
      <p class="ds-lead ds-page__intro">Every version of Cadence and what shipped with it.</p>
    </header>

    <ol class="ds-list ds-stagger">
      {entries.map((entry) => (
        <li class="release">
          <div class="release__head">
            <span class="ds-mono">v{entry.version}</span>
            <span class="ds-mono">{entry.date}</span>
          </div>
          <h2 class="ds-title release__headline">{entry.headline}</h2>

          {entry.sections.map((section) => (
            <div class="change">
              <span class={`ds-mark ds-mark--${MARK[section.label] ?? 'idle'}`}>{section.label}</span>
              <ul class="change__items">
                {section.items.map((item) => <li class="ds-small" set:html={inline(item)} />)}
              </ul>
            </div>
          ))}
        </li>
      ))}
    </ol>
  </div>

  <style>
    /* Screen-level layout only; tone and type come from the design system. */
    /* The log reads as prose, so it sits on the reading measure rather than
       the full page measure `.ds-page` defaults to. The head gets the room a
       reading page opens with before the first hairline starts the list. */
    .log-page { max-width: var(--measure-read); }
    .log-page .ds-page__head { margin-bottom: var(--space-16); }

    /* `.ds-list` draws the hairline between releases; each release only has to
       hold its own air. */
    .release { padding-block: var(--space-8); }
    .release:first-child { padding-top: 0; }
    .release:last-child { padding-bottom: 0; }

    .release__head { display: flex; align-items: baseline; gap: var(--space-4); }
    .release__headline { margin: var(--space-2) 0 var(--space-5); }

    .change { margin-bottom: var(--space-5); }
    .change:last-child { margin-bottom: 0; }
    .change__items { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
    /* The bullet sits outside the text flow: the item's children are injected
       inline markup, and a grid here would scatter them into separate cells. */
    .change__items li {
      position: relative; padding-left: var(--space-5);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-1);
    }
    .change__items li::before { content: '·'; position: absolute; left: var(--space-1); }
    /* Emphasis carries the full ink; the identifier keeps the readout voice from
       `.ds-mono`. Injected by `set:html`, so it carries no scope hash and must be
       addressed globally. */
    :global(.change__strong) { color: rgb(var(--ink)); font-weight: var(--weight-medium); }
  </style>
</PlatformLayout>
