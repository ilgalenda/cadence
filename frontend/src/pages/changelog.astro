---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { CHANGELOG } from '../lib/version';

const entries = [...CHANGELOG].sort((a, b) => b.version.localeCompare(a.version, undefined, { numeric: true }));

const labelClass: Record<string, string> = {
  Added: 'text-signal-success',
  Changed: 'text-accent',
  Fixed: 'text-accent',
  Security: 'text-signal-warning',
  Removed: 'text-signal-danger',
};
---
<DashboardLayout title="Changelog">
  <section class="max-w-3xl mx-auto px-8 py-10">
    <header class="mb-10">
      <p class="font-mono text-[11px] uppercase tracking-label text-ink-muted mb-2">// changelog</p>
      <h1 class="text-3xl font-semibold tracking-tightest leading-tight mb-2">Cadence release log.</h1>
      <p class="text-sm text-ink-secondary">Every version of Cadence and what shipped with it.</p>
    </header>

    <ol class="space-y-12">
      {entries.map((entry) => (
        <li class="border-l border-rule-subtle pl-6 relative">
          <span class="absolute -left-1.5 top-1 w-3 h-3 rounded-full bg-accent"></span>

          <div class="flex items-baseline gap-3 mb-1">
            <h2 class="text-xl font-semibold tracking-tightest">v{entry.version}</h2>
            <span class="font-mono text-[11px] uppercase tracking-label text-ink-muted">{entry.date}</span>
          </div>
          <p class="text-sm text-ink-secondary mb-5">{entry.headline}</p>

          <div class="space-y-5">
            {entry.sections.map((section) => (
              <div>
                <p class={`font-mono text-[10px] uppercase tracking-label mb-2 ${labelClass[section.label] ?? 'text-ink-muted'}`}>
                  {section.label}
                </p>
                <ul class="space-y-1.5">
                  {section.items.map((item) => (
                    <li class="text-sm text-ink-primary leading-snug flex gap-2">
                      <span class="text-ink-muted shrink-0" aria-hidden="true">·</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </section>
</DashboardLayout>
